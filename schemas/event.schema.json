{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Historical Event",
  "description": "A single historical event in the Internet timeline",
  "type": "object",
  "required": [
    "id",
    "title",
    "year",
    "category",
    "type",
    "impact",
    "nostalgia"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier (kebab-case, includes year)",
      "pattern": "^[A-Za-z0-9.-]+-\\d{4}(?:-preview)?$"
    },
    "title": {
      "type": "string",
      "description": "Display name of the event"
    },
    "year": {
      "type": "integer",
      "minimum": 1990,
      "maximum": 2030
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Specific date if known (YYYY-MM-DD)"
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "bangladesh",
          "browser",
          "business",
          "communication",
          "cultural-event",
          "culture",
          "design",
          "development",
          "e-commerce",
          "entertainment",
          "fashion",
          "gadget",
          "gaming",
          "hardware",
          "history",
          "infrastructure",
          "innovation",
          "media",
          "multimedia",
          "music",
          "news",
          "open-source",
          "operating-system",
          "science",
          "search",
          "security",
          "social",
          "software",
          "standards",
          "tech",
          "viral-culture",
          "web"
        ]
      },
      "minItems": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "acquisition",
        "business_decision",
        "business_event",
        "business_milestone",
        "community_event",
        "company_launch",
        "company_rebrand",
        "cultural_event",
        "cultural_moment",
        "cultural_shift",
        "culture_moment",
        "design_trend",
        "hardware_release",
        "infrastructure_incident",
        "innovation",
        "internet_meme",
        "ipo",
        "launch",
        "legal_event",
        "market_event",
        "media_launch",
        "milestone",
        "organization",
        "platform_growth",
        "platform_launch",
        "platform_peak",
        "platform_shift",
        "platform_shutdown",
        "political_event",
        "prediction",
        "product_announcement",
        "product_launch",
        "regulation",
        "regulatory_event",
        "scandal",
        "security_event",
        "security_incident",
        "shutdown",
        "social_trend",
        "software_release",
        "standard_release",
        "standardization",
        "standards",
        "technology_breakthrough",
        "technology_release",
        "viral_event",
        "website_launch"
      ]
    },
    "summary": {
      "type": "string",
      "description": "Brief factual description"
    },
    "narrative": {
      "type": "string",
      "description": "Human-written editorial narrative"
    },
    "why_it_matters": {
      "type": "string",
      "description": "Why this event shaped the Internet"
    },
    "impact": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Historical importance (1=Minor, 5=Defining)"
    },
    "nostalgia": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Emotional nostalgia factor (1=Low, 5=High)"
    },
    "influence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of events this influenced"
    },
    "inspired_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of events that inspired this"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "region": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "asia",
          "bangladesh",
          "china",
          "europe",
          "global",
          "israel",
          "japan",
          "south-asia",
          "usa"
        ]
      },
      "default": [
        "global"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "screenshot",
              "product_photo",
              "logo",
              "advertisement",
              "photograph",
              "ui",
              "website",
              "poster",
              "video",
              "icon",
              "illustration"
            ]
          },
          "image": {
            "type": "string"
          },
          "video_id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "title",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "community"
          ]
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  }
}
