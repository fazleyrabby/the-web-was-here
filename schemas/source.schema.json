{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source",
  "description": "A source reference for historical claims",
  "type": "object",
  "required": ["title", "url", "type", "confidence"],
  "properties": {
    "title": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "type": {
      "type": "string",
      "enum": ["primary", "secondary", "community"]
    },
    "accessed": { "type": "string", "format": "date" },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "notes": { "type": "string" }
  }
}
