<script>
  import { playWarpSound, playDialUpSound, stopDialUp } from '../lib/sound';

  function initHeroInteractive() {
    const warpBtn = document.getElementById('hero-warp-btn');
    const warpText = document.getElementById('hero-warp-text');
    const crtSoundBtn = document.getElementById('crt-sound-btn');
    const crtStatusText = document.getElementById('crt-status-text');
    const crtFrame = document.getElementById('crt-frame');

    const years = [
      1990,1991,1992,1993,1994,1995,1996,1997,1998,1999,
      2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,
      2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,
      2020,2021,2022,2023,2024,2025,2026
    ];

    if (warpBtn && warpText) {
      let isWarping = false;
      warpBtn.onclick = () => {
        if (isWarping) return;
        isWarping = true;
        playWarpSound();

        const targetYear = years[Math.floor(Math.random() * years.length)];
        let counter = 0;
        const interval = setInterval(() => {
          const preview = years[Math.floor(Math.random() * years.length)];
          warpText.textContent = `Warping to ${preview}...`;
          counter++;
          if (counter >= 7) {
            clearInterval(interval);
            warpText.textContent = `⚡ Jumping to ${targetYear}!`;
            setTimeout(() => {
              window.location.href = `/the-web/${targetYear}`;
            }, 250);
          }
        }, 60);
      };
    }

    if (crtSoundBtn && crtStatusText && crtFrame) {
      let isPlaying = false;
      let stopFn: (() => void) | null = null;

      crtSoundBtn.onclick = (e) => {
        e.stopPropagation();
        if (isPlaying) {
          if (stopFn) stopFn();
          stopDialUp();
          isPlaying = false;
          crtFrame.classList.remove('hero__frame--connecting');
          crtStatusText.textContent = '🔊 56K DIAL-UP';
          return;
        }

        isPlaying = true;
        crtFrame.classList.add('hero__frame--connecting');
        crtStatusText.textContent = 'DIALING...';

        stopFn = playDialUpSound((status) => {
          crtStatusText.textContent = status;
          if (status === 'ONLINE' || status === 'CONNECTED @ 56,000 BPS!') {
            setTimeout(() => {
              isPlaying = false;
              crtFrame.classList.remove('hero__frame--connecting');
              crtStatusText.textContent = '● 56K ONLINE';
            }, 3000);
          }
        });
      };
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroInteractive);
  } else {
    initHeroInteractive();
  }
  document.addEventListener('astro:page-load', initHeroInteractive);
</script>