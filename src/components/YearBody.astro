---
interface EventSource {
  title: string;
  url: string;
}

interface WebEvent {
  id: string;
  title: string;
  year: number;
  date?: string;
  category: string[];
  type?: string;
  summary?: string;
  narrative: string;
  why_it_matters?: string;
  impact: number;
  nostalgia: number;
  influence?: string[];
  tags?: string[];
  sources: EventSource[];
  image?: string;
  image_caption?: string;
}

interface Props {
  events: WebEvent[];
  feltLike?: Record<string, string>;
}

const { events, feltLike } = Astro.props;

const accentColors = [
  'var(--pink)',
  'var(--green)',
  'var(--yellow)',
  'var(--blue)',
  'var(--orange)',
  'var(--purple)',
  'var(--teal)',
];

const allCategories = Array.from(
  new Set(events.flatMap((e) => e.category || []))
).sort();
---

{feltLike && (
  <section class="felt-like">
    <div class="felt-like__header">
      <span class="felt-like__eyebrow">Time capsule</span>
      <h3 class="felt-like__heading">What it felt like</h3>
    </div>
    <div class="felt-like__grid">
      {Object.entries(feltLike).map(([key, value], i) => (
        <div class="felt-like__item scroll-reveal-card" style={`--item-accent: ${accentColors[i % accentColors.length]}; --reveal-delay: ${i * 60}ms`}>
          <span class="felt-like__key">{key.replace(/_/g, ' ')}</span>
          <span class="felt-like__value">{value}</span>
        </div>
      ))}
    </div>
  </section>
)}

<section class="events">
  <div class="events__header">
    <div class="events__header-text">
      <span class="events__eyebrow">The timeline</span>
      <h2 class="events__heading">Events that shaped the year</h2>
    </div>
    <div class="events__filter-bar" id="events-filter-bar">
      <span class="events__filter-label">CATEGORY:</span>
      <button class="events__filter-pill active" data-category="all">
        ALL <span class="filter-count">({events.length})</span>
      </button>
      {allCategories.map((cat) => {
        const count = events.filter((e) => e.category?.includes(cat)).length;
        return (
          <button class="events__filter-pill" data-category={cat}>
            {cat} <span class="filter-count">({count})</span>
          </button>
        );
      })}
    </div>
  </div>
  <div class="events__list">
    {events.map((event, i) => (
      <article
        class="event scroll-reveal-card"
        id={event.id}
        data-event
        data-categories={event.category.join(' ')}
        style={`--accent: ${accentColors[i % accentColors.length]}; --reveal-delay: ${Math.min(i, 6) * 60}ms`}
      >
        <div class="event__left">
          <span class="event__index">{String(i + 1).padStart(2, '0')}</span>
          <div class="event__scores">
            <div class="event__score" title={`Impact: ${event.impact}/5`}>
              <span class="event__score-label">IMP</span>
              <span class="event__score-bar">{'█'.repeat(event.impact)}{'░'.repeat(5 - event.impact)}</span>
            </div>
            <div class="event__score event__score--nostalgia" title={`Nostalgia: ${event.nostalgia}/5`}>
              <span class="event__score-label">NOS</span>
              <span class="event__score-bar">{'█'.repeat(event.nostalgia)}{'░'.repeat(5 - event.nostalgia)}</span>
            </div>
          </div>
        </div>
        <div class="event__right">
          <div class="event__meta">
            <span class="event__categories">
              {event.type && (
                <span class="event__type">{event.type.replace(/_/g, ' ')}</span>
              )}
              {event.category.map((cat) => (
                <span class="event__category">{cat}</span>
              ))}
            </span>
            <div class="event__meta-right">
              {event.date && <span class="event__date">{event.date}</span>}
              <button class="event__react-btn" aria-label="Relive this moment" title="Relive this moment">✨ Relive</button>
            </div>
          </div>
          <h3 class="event__title">{event.title}</h3>
          <div class={`event__body ${event.image ? 'event__body--has-image' : ''}`}>
            <div class="event__text">
              <div class="event__text-body">
                <p class="event__narrative">{event.narrative}</p>
                {event.why_it_matters && <p class="event__why">{event.why_it_matters}</p>}
              </div>
              <button class="event__more" type="button" aria-expanded="false">Read more</button>
            </div>
            {event.image && (
              <figure class="event__figure">
                <button
                  type="button"
                  class="event__image-frame event__image-frame--interactive"
                  data-lightbox-trigger
                  data-img-src={event.image}
                  data-img-caption={event.image_caption || event.title}
                  data-img-title={event.title}
                  data-img-year={event.year}
                  title="Click to view full artifact"
                  aria-label={`View full image for ${event.title}`}
                >
                  <img
                    src={event.image}
                    alt={event.title}
                    loading="lazy"
                    class="event__image"
                    onerror="this.closest('.event__figure').style.display='none'"
                  />
                  <span class="event__image-zoom-badge" aria-hidden="true">🔍</span>
                </button>
                {event.image_caption && (
                  <figcaption class="event__caption">{event.image_caption}</figcaption>
                )}
              </figure>
            )}
          </div>
          {event.sources && event.sources.length > 0 && (
            <div class="event__sources">
              <svg class="event__arrow" viewBox="0 0 48 48" fill="none"><path d="M8 24 Q 16 18 24 24 T 40 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none" /><path d="M34 18 L 40 24 L 34 30" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
              {event.sources.map((source) => (
                <a href={source.url} class="event__source" target="_blank" rel="noopener">{source.title}</a>
              ))}
            </div>
          )}
          {event.tags && event.tags.length > 0 && (
            <div class="event__tags">
              {event.tags.map((tag) => (
                <span class="event__tag">#{tag}</span>
              ))}
            </div>
          )}
          {event.influence && event.influence.length > 0 && (
            <div class="event__influences">
              <span class="event__influences-label">Influenced:</span>
              <div class="event__influences-list">
                {event.influence.map((inf) => {
                  const matchYear = inf.match(/-(\d{4})$/);
                  if (matchYear) {
                    return (
                      <a href={`/the-web/${matchYear[1]}#${inf}`} class="event__influence-pill event__influence-pill--link" title={`Jump to ${inf}`}>
                        <span>{inf.replace(/-\d{4}$/, '').replace(/-/g, ' ')}</span>
                        <span class="influence-year">({matchYear[1]})</span>
                      </a>
                    );
                  }
                  return (
                    <span class="event__influence-pill">
                      {inf.replace(/-/g, ' ')}
                    </span>
                  );
                })}
              </div>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<!-- Image Lightbox Modal -->
<div class="lightbox-modal" id="lightbox-modal" role="dialog" aria-modal="true" aria-label="Historical visual artifact" hidden>
  <div class="lightbox-modal__backdrop" id="lightbox-backdrop"></div>
  <div class="lightbox-modal__dialog">
    <div class="lightbox-modal__header">
      <div class="lightbox-modal__info">
        <span class="lightbox-modal__year" id="lightbox-year"></span>
        <h4 class="lightbox-modal__title" id="lightbox-title"></h4>
      </div>
      <button type="button" class="lightbox-modal__close" id="lightbox-close" aria-label="Close image viewer">✕</button>
    </div>
    <div class="lightbox-modal__media">
      <img id="lightbox-img" src="" alt="" />
    </div>
    <p class="lightbox-modal__caption" id="lightbox-caption"></p>
  </div>
</div>

<style>
  .felt-like { margin-bottom: var(--spacing-xl); padding: var(--spacing-md); background: var(--bg); border: var(--border-thick); border-radius: 4px; box-shadow: 6px 6px 0 var(--bark); }
  .felt-like__header { margin-bottom: var(--spacing-md); }
  .felt-like__eyebrow { font-family: var(--font-mono); font-size: 0.72rem; color: var(--pink); text-transform: uppercase; letter-spacing: 0.12em; display: block; margin-bottom: var(--spacing-xs); font-weight: 600; }
  .felt-like__heading { font-family: var(--font-hand); font-size: 1.8rem; font-weight: 700; color: var(--ink); }
  .felt-like__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--spacing-sm); }
  .felt-like__item { padding: var(--spacing-sm); background: var(--bg-elevated); border: 2.5px solid var(--bark); border-radius: 3px; box-shadow: 3px 3px 0 var(--bark); transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out); display: flex; flex-direction: column; gap: 0.3rem; }
  .felt-like__item:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--item-accent); border-color: var(--bark); }
  .felt-like__key { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; display: inline-block; align-self: flex-start; padding: 0.15rem 0.5rem; background: var(--bg-elevated); border: 1.5px solid var(--item-accent); border-radius: 3px; }
  .felt-like__value { font-family: var(--font-body); font-size: 0.95rem; color: var(--text-primary); line-height: 1.5; display: block; overflow-wrap: anywhere; }
  
  .events__header {
    margin-bottom: var(--spacing-lg);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }
  .events__eyebrow { font-family: var(--font-mono); font-size: 0.72rem; color: var(--green); text-transform: uppercase; letter-spacing: 0.12em; display: block; margin-bottom: var(--spacing-xs); font-weight: 600; }
  .events__heading { font-family: var(--font-hand); font-size: 1.9rem; font-weight: 700; color: var(--ink); }

  /* Category Filter Pills */
  .events__filter-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    padding: 0.4rem 0;
  }
  .events__filter-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-right: 0.2rem;
  }
  .events__filter-pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    background: var(--bg-card);
    border: 2px solid var(--bark);
    border-radius: 3px;
    box-shadow: 2px 2px 0 var(--bark);
    color: var(--ink);
    cursor: pointer;
    transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out), background 0.15s, color 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .events__filter-pill:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--bark);
    background: var(--bg-elevated);
  }
  .events__filter-pill.active {
    background: var(--pink);
    color: #fff;
    box-shadow: 3px 3px 0 var(--bark);
    transform: translate(-1px, -1px);
  }
  .events__filter-pill.active .filter-count {
    color: rgba(255, 255, 255, 0.85);
  }
  .filter-count {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .events__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 480px), 1fr)); gap: var(--spacing-md); align-items: start; }
  .event { display: grid; grid-template-columns: 70px 1fr; gap: var(--spacing-md); padding: var(--spacing-md); background: var(--bg-card); border: var(--border-thick); border-radius: 4px; box-shadow: 6px 6px 0 var(--bark); transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out), outline 0.2s; position: relative; }
  .event:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--accent); }
  .event--hidden { display: none !important; }
  .event--highlighted {
    animation: highlightPulse 2.5s ease-out;
  }
  @keyframes highlightPulse {
    0% { outline: 4px solid var(--pink); box-shadow: 0 0 25px var(--pink); }
    100% { outline: 0px solid transparent; }
  }
  
  .event__left { display: flex; flex-direction: column; align-items: center; gap: var(--spacing-sm); padding-top: var(--spacing-xs); }
  .event__index { font-family: var(--font-hand); font-size: 2rem; font-weight: 700; color: var(--accent); line-height: 1; opacity: 0.75; }
  .event__scores { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .event__score { display: flex; flex-direction: column; gap: 2px; }
  .event__score-label { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); letter-spacing: 0.08em; font-weight: 600; }
  .event__score-bar { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.03em; }
  .event__score--nostalgia .event__score-bar { color: var(--green); }
  .event__right { min-width: 0; }
  .event__meta { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem; margin-bottom: var(--spacing-sm); }
  .event__meta-right { display: flex; align-items: center; gap: var(--spacing-sm); }
  .event__categories { display: flex; gap: var(--spacing-xs); flex-wrap: wrap; align-items: center; }
  .event__type {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.45rem;
    background: var(--bg-card);
    border: 1.5px solid var(--bark);
    border-radius: 2px;
    color: var(--ink);
  }
  .event__category { font-family: var(--font-mono); font-size: 0.72rem; color: #fff; padding: 0.25rem 0.65rem; border: 2px solid var(--bark); border-radius: 2px; text-transform: uppercase; letter-spacing: 0.05em; background: var(--accent); font-weight: 600; box-shadow: 2px 2px 0 var(--bark); }
  .event__date { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); font-weight: 500; }
  .event__react-btn { font-family: var(--font-hand); font-size: 1.05rem; font-weight: 600; color: #0a0a0a; background: var(--yellow); border: 2px solid var(--bark); border-radius: 3px; padding: 0.2rem 0.6rem; cursor: pointer; box-shadow: 2px 2px 0 var(--bark); transition: transform 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out), background 0.15s, color 0.15s; }
  .event__react-btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--bark); background: var(--pink); color: #fff; }
  .event__react-btn.relived { background: var(--green) !important; color: #fff !important; }
  .event__title { font-family: var(--font-hand); font-size: 1.5rem; font-weight: 700; color: var(--accent); margin-bottom: var(--spacing-sm); line-height: 1.2; overflow-wrap: anywhere; }
  .event__body--has-image { display: grid; grid-template-columns: 1fr 170px; gap: var(--spacing-md); align-items: start; }
  .event__text { min-width: 0; }
  
  /* Mask-based fade prevents grayish artifacts on dark & glassmorphism themes */
  .event__text-body {
    position: relative;
    max-height: 9rem;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, black calc(100% - 2.5rem), transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black calc(100% - 2.5rem), transparent 100%);
  }
  .event--expanded .event__text-body {
    max-height: none;
    mask-image: none;
    -webkit-mask-image: none;
  }
  .event__more { display: inline-flex; align-items: center; margin-top: 0.35rem; padding: 0; background: none; border: none; cursor: pointer; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--blue); }
  .event__more:hover { color: var(--pink); text-decoration: underline; }
  .event--expanded .event__more { color: var(--text-muted); }
  
  .event__figure { margin: 0; width: 100%; max-width: 170px; }
  .event__image-frame {
    cursor: zoom-in;
    position: relative;
    width: 100%;
    padding: var(--spacing-xs);
    border: 2.5px solid var(--bark);
    border-radius: 4px;
    background: #ffffff;
    box-shadow: 4px 4px 0 var(--bark);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 110px;
    max-height: 150px;
    margin-bottom: 6px;
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  .event__image-frame:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--bark);
  }
  .event__image { max-width: 100%; max-height: 175px; width: auto; height: auto; object-fit: contain; display: block; margin: 0 auto; }
  .event__image-zoom-badge {
    position: absolute;
    bottom: 5px;
    right: 5px;
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    border-radius: 999px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    opacity: 0;
    transition: opacity 0.15s;
    pointer-events: none;
  }
  .event__image-frame:hover .event__image-zoom-badge {
    opacity: 1;
  }
  .event__caption { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); line-height: 1.4; letter-spacing: 0.02em; }
  .event__narrative { font-size: 0.96rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: var(--spacing-sm); max-width: none; overflow-wrap: anywhere; }
  .event__why { font-family: var(--font-editorial); font-style: italic; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.55; padding: var(--spacing-sm) var(--spacing-md); border: 2px dashed var(--bark); border-radius: 3px; background: rgba(255, 255, 255, 0.5); margin-bottom: var(--spacing-sm); overflow-wrap: anywhere; }
  .event__sources { margin-top: var(--spacing-sm); padding-top: var(--spacing-sm); border-top: 2.5px dashed var(--bark); display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .event__arrow { width: 24px; height: 24px; color: var(--green); flex-shrink: 0; }
  .event__source { font-family: var(--font-hand); font-size: 1.15rem; font-weight: 600; color: var(--blue); text-decoration: underline; text-decoration-style: wavy; text-decoration-color: var(--bark); text-underline-offset: 3px; transition: color 0.2s; overflow-wrap: anywhere; }
  .event__source:hover { color: var(--pink); }

  /* Tags & Influences */
  .event__tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.35rem;
  }
  .event__tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }
  .event__influences {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
    padding-top: 0.45rem;
    border-top: 1.5px dotted var(--bark);
  }
  .event__influences-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .event__influences-list {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .event__influence-pill {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    background: var(--bg-elevated);
    border: 1px solid var(--bark);
    border-radius: 3px;
    color: var(--ink);
    text-transform: capitalize;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .event__influence-pill--link {
    text-decoration: none;
    transition: transform 0.15s, background 0.15s, color 0.15s;
    cursor: pointer;
  }
  .event__influence-pill--link:hover {
    background: var(--pink);
    color: #fff;
    transform: translateY(-1px);
    border-color: var(--bark);
  }
  .event__influence-pill--link:hover .influence-year {
    color: rgba(255, 255, 255, 0.85);
  }
  .influence-year {
    font-size: 0.6rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  /* Lightbox Modal */
  .lightbox-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .lightbox-modal[hidden] {
    display: none !important;
  }
  .lightbox-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 14, 0.85);
    backdrop-filter: blur(8px);
  }
  .lightbox-modal__dialog {
    position: relative;
    z-index: 2;
    background: var(--bg-card, #1a1714);
    border: 3px solid var(--bark, #333);
    box-shadow: 10px 10px 0 var(--bark, #000);
    border-radius: 6px;
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: lightboxPop 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes lightboxPop {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
  .lightbox-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 1.2rem;
    border-bottom: 2px solid var(--bark);
    background: var(--bg-elevated);
  }
  .lightbox-modal__year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--pink);
    text-transform: uppercase;
  }
  .lightbox-modal__title {
    font-family: var(--font-hand);
    font-size: 1.5rem;
    margin: 0;
    color: var(--ink);
  }
  .lightbox-modal__close {
    background: var(--yellow);
    border: 2px solid var(--bark);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: #000;
    cursor: pointer;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 2px 2px 0 var(--bark);
    transition: transform 0.15s, background 0.15s;
  }
  .lightbox-modal__close:hover {
    transform: translate(-1px, -1px);
    background: var(--pink);
    color: #fff;
  }
  .lightbox-modal__media {
    padding: 1rem;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex: 1;
    min-height: 250px;
  }
  .lightbox-modal__media img {
    max-width: 100%;
    max-height: 60vh;
    object-fit: contain;
    border-radius: 2px;
  }
  .lightbox-modal__caption {
    padding: 0.8rem 1.2rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-secondary);
    border-top: 1.5px solid var(--bark);
    background: var(--bg-card);
  }

  .confetti-dot { position: fixed; width: 10px; height: 10px; border-radius: 2px; pointer-events: none; z-index: 9998; border: 2px solid var(--bark); will-change: transform, opacity; }
  
  @media (max-width: 900px) {
    .event__body--has-image { grid-template-columns: 1fr; gap: var(--spacing-md); }
    .event__figure { max-width: 100%; margin-top: var(--spacing-xs); }
  }
  @media (max-width: 768px) {
    .felt-like {
      padding: var(--spacing-md);
      margin-bottom: var(--spacing-xl);
      box-shadow: 4px 4px 0 var(--bark);
    }
    .felt-like__header {
      margin-bottom: var(--spacing-md);
    }
    .felt-like__heading {
      font-size: 1.8rem;
    }
    .felt-like__grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
    .felt-like__item {
      padding: 0.85rem 1rem;
    }
    .events__header {
      margin-bottom: var(--spacing-lg);
    }
    .events__heading {
      font-size: 1.8rem;
    }
    .events__list {
      gap: var(--spacing-lg);
    }
    .event {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
      padding: 1.15rem;
      box-shadow: 4px 4px 0 var(--bark);
    }
    .event:hover {
      box-shadow: 6px 6px 0 var(--accent);
      transform: translate(-2px, -2px);
    }
    .event__left {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding-top: 0;
      padding-bottom: var(--spacing-xs);
      border-bottom: 2px dashed rgba(26, 26, 26, 0.2);
      width: 100%;
    }
    .event__index {
      font-size: 2rem;
    }
    .event__scores {
      flex-direction: row;
      gap: var(--spacing-md);
    }
    .event__title {
      font-size: 1.7rem;
      margin-bottom: var(--spacing-sm);
    }
    .event__narrative {
      font-size: 0.98rem;
      line-height: 1.65;
    }
    .event__why {
      padding: 0.75rem 0.85rem;
      font-size: 0.9rem;
    }
  }
</style>

<script>
  import { playChimeSound } from '../lib/sound';

  const CONFETTI_COLORS = ['#e6194b', '#00994d', '#f0b800', '#2255ee', '#e65522', '#8822ee', '#009988'];

  function burst(x: number, y: number) {
    const n = 18;
    for (let i = 0; i < n; i++) {
      const dot = document.createElement('span');
      dot.className = 'confetti-dot';
      dot.style.background = CONFETTI_COLORS[i % CONFETTI_COLORS.length];
      dot.style.left = x + 'px';
      dot.style.top = y + 'px';
      document.body.appendChild(dot);

      const angle = (Math.PI * 2 * i) / n + Math.random() * 0.6;
      const dist = 70 + Math.random() * 110;
      const dx = Math.cos(angle) * dist;
      const dy = Math.sin(angle) * dist;
      const spin = Math.random() * 540 - 270;

      const anim = dot.animate(
        [
          { transform: 'translate(-50%, -50%) scale(1) rotate(0deg)', opacity: 1 },
          { transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) scale(0.3) rotate(${spin}deg)`, opacity: 0 },
        ],
        { duration: 650 + Math.random() * 350, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
      );
      anim.onfinish = () => dot.remove();
    }
  }

  function initYearPage() {
    // 1. Reactions + 8-bit chime
    document.querySelectorAll('.event__react-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        playChimeSound();
        const rect = (btn as HTMLElement).getBoundingClientRect();
        burst(rect.left + rect.width / 2, rect.top + rect.height / 2);

        btn.classList.add('relived');
        const originalText = btn.textContent;
        btn.textContent = '✨ Relived! 🎉';
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('relived');
        }, 2200);
      });
    });

    // 2. Category Filters
    const pills = document.querySelectorAll('.events__filter-pill');
    const articles = document.querySelectorAll<HTMLElement>('.event[data-categories]');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const filter = pill.getAttribute('data-category');
        articles.forEach((article) => {
          if (!filter || filter === 'all') {
            article.classList.remove('event--hidden');
          } else {
            const cats = (article.getAttribute('data-categories') || '').split(' ');
            if (cats.includes(filter)) {
              article.classList.remove('event--hidden');
            } else {
              article.classList.add('event--hidden');
            }
          }
        });
      });
    });

    // 3. Read more / less toggle for long narratives
    document.querySelectorAll<HTMLElement>('.event').forEach((article) => {
      const body = article.querySelector<HTMLElement>('.event__text-body');
      const more = article.querySelector<HTMLButtonElement>('.event__more');
      if (!body || !more) return;
      if (body.scrollHeight <= body.clientHeight + 4) {
        more.style.display = 'none';
        return;
      }
      more.onclick = (e) => {
        e.stopPropagation();
        const expanded = article.classList.toggle('event--expanded');
        more.textContent = expanded ? 'Show less' : 'Read more';
        more.setAttribute('aria-expanded', String(expanded));
      };
    });

    // 4. Lightbox Modal
    const lightbox = document.getElementById('lightbox-modal');
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lbTitle = document.getElementById('lightbox-title');
    const lbYear = document.getElementById('lightbox-year');
    const lbCaption = document.getElementById('lightbox-caption');
    const lbClose = document.getElementById('lightbox-close');
    const lbBackdrop = document.getElementById('lightbox-backdrop');

    function openLightbox(src: string, caption: string, title: string, year: string) {
      if (!lightbox || !lbImg) return;
      lbImg.src = src;
      lbImg.alt = title;
      if (lbTitle) lbTitle.textContent = title;
      if (lbYear) lbYear.textContent = year;
      if (lbCaption) lbCaption.textContent = caption;
      lightbox.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.setAttribute('hidden', '');
      document.body.style.overflow = '';
      if (lbImg) lbImg.src = '';
    }

    document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const src = el.getAttribute('data-img-src') || '';
        const caption = el.getAttribute('data-img-caption') || '';
        const title = el.getAttribute('data-img-title') || '';
        const year = el.getAttribute('data-img-year') || '';
        if (src) openLightbox(src, caption, title, year);
      });
    });

    lbClose?.addEventListener('click', closeLightbox);
    lbBackdrop?.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox && !lightbox.hasAttribute('hidden')) {
        closeLightbox();
      }
    });

    // 5. Deep link highlighting if hash exists in URL (e.g. #iphone-2007)
    if (window.location.hash) {
      const target = document.querySelector<HTMLElement>(window.location.hash);
      if (target) {
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          target.classList.add('event--highlighted');
          setTimeout(() => target.classList.remove('event--highlighted'), 3000);
        }, 150);
      }
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initYearPage);
  else initYearPage();
  document.addEventListener('astro:page-load', initYearPage);
</script>
