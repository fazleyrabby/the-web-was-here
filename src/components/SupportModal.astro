---
// Support Modal Component — The Web Was Here Neo-Brutalist Theme
---

<div class="modal-backdrop" id="support-modal-backdrop" aria-hidden="true" role="dialog" aria-labelledby="support-title">
  <div class="support-modal-box" id="support-modal">
    <!-- Retro Window Bar -->
    <div class="support-window-bar">
      <div class="support-window-left">
        <span class="support-window-dot dot--red"></span>
        <span class="support-window-dot dot--yellow"></span>
        <span class="support-window-dot dot--green"></span>
        <span class="support-window-title">TWWH_ARCHIVE // SUPPORT.EXE</span>
      </div>
      <button type="button" class="support-window-close" id="support-modal-close" aria-label="Close modal">
        ✕
      </button>
    </div>

    <div class="support-modal-body">
      <!-- Header -->
      <div class="support-header">
        <div class="support-icon-badge">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
        </div>
        <div class="support-title-group">
          <h2 class="support-title" id="support-title">Support the Project</h2>
          <p class="support-subtitle">Keep independent digital history & creative coding alive</p>
        </div>
      </div>

      <!-- Archival & Project Notice Banner -->
      <div class="support-homelab-banner">
        <div class="support-homelab-badge">
          <span class="support-homelab-icon">💾</span>
          <span class="support-homelab-ping" aria-hidden="true"></span>
        </div>
        <div class="support-homelab-info">
          <div class="support-homelab-heading">
            <strong class="support-homelab-title">Independent Living Archive</strong>
            <span class="support-homelab-pill">36+ YEARS PRESERVED</span>
          </div>
          <p class="support-homelab-desc">
            The Web Was Here is an independent, non-profit archive preserving three decades of internet milestones. Every contribution directly funds research, asset archival, and dedicated hosting!
          </p>
        </div>
      </div>

      <!-- Cards Container -->
      <div class="support-cards-list">
        <!-- 1. SupportKori (Bangladesh) -->
        <a href="https://supportkori.com/fazleyrabbi" target="_blank" rel="noopener noreferrer" class="support-tier-card card-kori">
          <div class="tier-card-left">
            <div class="tier-icon-badge kori-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </div>
            <div class="tier-info">
              <span class="tier-title">SupportKori</span>
              <div class="tier-tag-pill kori-tag">
                <span>🇧🇩 BD USERS / BKASH • NAGAD</span>
              </div>
              <span class="tier-desc">For Bangladesh contributors (BDT ৳)</span>
            </div>
          </div>
          <div class="tier-action-btn kori-btn">
            <span>Support ৳</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>

        <!-- 2. Buy Me a Coffee (Global) -->
        <a href="https://buymeacoffee.com/fazleyrabbi" target="_blank" rel="noopener noreferrer" class="support-tier-card card-bmc">
          <div class="tier-card-left">
            <div class="tier-icon-badge bmc-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
                <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
                <line x1="6" y1="1" x2="6" y2="4"></line>
                <line x1="10" y1="1" x2="10" y2="4"></line>
                <line x1="14" y1="1" x2="14" y2="4"></line>
              </svg>
            </div>
            <div class="tier-info">
              <span class="tier-title">Buy Me a Coffee</span>
              <div class="tier-tag-pill bmc-tag">
                <span>GLOBAL / INTERNATIONAL</span>
              </div>
              <span class="tier-desc">Card, Apple Pay, Google Pay ($)</span>
            </div>
          </div>
          <div class="tier-action-btn bmc-btn">
            <span>Support $</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      </div>

      <!-- Section Divider -->
      <div class="support-divider">
        <div class="divider-line"></div>
        <span class="divider-text">OR DIRECT PAYONEER ($0 FEE)</span>
        <div class="divider-line"></div>
      </div>

      <!-- Payoneer Box -->
      <div class="payoneer-box" id="btn-copy-payoneer" role="button" tabindex="0" title="Click to copy Payoneer ID">
        <div class="payoneer-top-row">
          <span class="payoneer-label">PAYONEER CUSTOMER ID:</span>
          <span class="payoneer-fee-tag">$0 FEE DIRECT</span>
        </div>

        <div class="payoneer-id-display">
          <span class="payoneer-id-value" id="payoneer-id-number">24076084</span>
          <button type="button" class="payoneer-copy-btn" id="btn-payoneer-copy-action" title="Copy Payoneer ID">
            <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="payoneer-copy-label">Copy ID</span>
          </button>
        </div>

        <div class="payoneer-tip">
          <span class="tip-bulb">💡</span>
          <span class="tip-text">Payoneer app: <strong>Pay → Pay to recipient</strong> → Enter ID <strong class="gold-id">24076084</strong> or <strong class="gold-id">fazley111@gmail.com</strong>.</span>
        </div>
      </div>

      <!-- Footer -->
      <div class="support-modal-footer">
        <span class="footer-thankyou">Thank you for keeping web history alive! ✨</span>
      </div>
    </div>
  </div>
</div>

<!-- Support Toast Container -->
<div id="support-toast-container" class="support-toast-container" aria-live="polite"></div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(26, 26, 26, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 16px;
    box-sizing: border-box;
  }

  .modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Retro Brutalist Window Container */
  .support-modal-box {
    width: 100%;
    max-width: 500px;
    background: var(--bg-card);
    border: var(--border-thick);
    border-radius: 4px;
    box-shadow: 10px 10px 0 var(--bark);
    transform: scale(0.95) translateY(12px);
    transition: transform 0.2s var(--ease-bounce);
    color: var(--text-primary);
    font-family: var(--font-body);
    box-sizing: border-box;
    max-height: 92vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .modal-backdrop.open .support-modal-box {
    transform: scale(1) translateY(0);
  }

  /* Window Title Bar */
  .support-window-bar {
    background: var(--bark);
    color: #ffffff;
    padding: 0.45rem 0.8rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    flex-shrink: 0;
  }

  .support-window-left {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .support-window-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    border: 1.5px solid #000;
  }

  .dot--red { background: var(--pink); }
  .dot--yellow { background: var(--yellow); }
  .dot--green { background: var(--green); }

  .support-window-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #f1f5f9;
    margin-left: 6px;
  }

  .support-window-close {
    width: 22px;
    height: 22px;
    background: var(--pink);
    color: #ffffff;
    border: 2px solid #000000;
    border-radius: 2px;
    box-shadow: 2px 2px 0 #000000;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    line-height: 1;
    padding: 0;
    transition: transform 0.1s, box-shadow 0.1s;
  }

  .support-window-close:hover {
    background: #ff3366;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #000000;
  }

  .support-window-close:active {
    transform: translate(1px, 1px);
    box-shadow: 0 0 0;
  }

  /* Body Content */
  .support-modal-body {
    background: var(--bg);
    padding: 20px 18px 18px 18px;
    overflow-y: auto;
    box-sizing: border-box;
  }

  /* Header */
  .support-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .support-icon-badge {
    width: 44px;
    height: 44px;
    border-radius: 3px;
    background: var(--yellow);
    border: 2.5px solid var(--bark);
    box-shadow: 3px 3px 0 var(--bark);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bark);
    flex-shrink: 0;
  }

  .support-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .support-title {
    font-family: var(--font-body);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--bark);
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.2;
  }

  .support-subtitle {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    margin: 0;
    font-weight: 500;
  }

  /* Archive Banner */
  .support-homelab-banner {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--bg-card);
    border: 2.5px solid var(--bark);
    border-radius: 3px;
    box-shadow: 3px 3px 0 var(--bark);
    padding: 10px 12px;
    margin-bottom: 14px;
  }

  .support-homelab-badge {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 3px;
    background: var(--bg);
    border: 2px solid var(--bark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .support-homelab-ping {
    position: absolute;
    top: -3px;
    right: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 6px var(--green);
    animation: support-pulse 1.8s infinite ease-in-out;
  }

  @keyframes support-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .support-homelab-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .support-homelab-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .support-homelab-title {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--bark);
  }

  .support-homelab-pill {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #ffffff;
    background: var(--green);
    border: 1.5px solid var(--bark);
    padding: 1px 6px;
    border-radius: 2px;
    text-transform: uppercase;
  }

  .support-homelab-desc {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  /* Cards List */
  .support-cards-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .support-tier-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-radius: 3px;
    text-decoration: none;
    border: 2.5px solid var(--bark);
    box-shadow: 3.5px 3.5px 0 var(--bark);
    cursor: pointer;
    background: var(--bg-card);
    transition: transform 0.15s var(--ease-bounce), box-shadow 0.15s var(--ease-bounce), background 0.15s;
  }

  /* SupportKori Styling */
  .card-kori:hover {
    background: #eefcf3;
    transform: translate(-2px, -2px);
    box-shadow: 5.5px 5.5px 0 var(--bark);
  }

  .card-kori:active,
  .card-bmc:active {
    transform: translate(1px, 1px);
    box-shadow: 1.5px 1.5px 0 var(--bark);
  }

  .kori-icon {
    width: 38px;
    height: 38px;
    border-radius: 3px;
    background: #00df89;
    border: 2px solid var(--bark);
    box-shadow: 2px 2px 0 var(--bark);
    color: var(--bark);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .kori-tag {
    background: #c6f6d5;
    border: 1.5px solid var(--bark);
    color: var(--bark);
  }

  .kori-btn {
    background: #00df89;
    color: var(--bark);
  }

  .kori-btn:hover {
    background: #20ff9d;
  }

  /* Buy Me a Coffee Styling */
  .card-bmc:hover {
    background: #fffde6;
    transform: translate(-2px, -2px);
    box-shadow: 5.5px 5.5px 0 var(--bark);
  }

  .bmc-icon {
    width: 38px;
    height: 38px;
    border-radius: 3px;
    background: var(--yellow);
    border: 2px solid var(--bark);
    box-shadow: 2px 2px 0 var(--bark);
    color: var(--bark);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .bmc-tag {
    background: #fef08a;
    border: 1.5px solid var(--bark);
    color: var(--bark);
  }

  .bmc-btn {
    background: var(--yellow);
    color: var(--bark);
  }

  .bmc-btn:hover {
    background: #ffe433;
  }

  /* Card Interior */
  .tier-card-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .tier-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .tier-title {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--bark);
  }

  .tier-tag-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 2px;
    letter-spacing: 0.04em;
    width: fit-content;
  }

  .tier-desc {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .tier-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 7px 12px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    flex-shrink: 0;
    border: 2px solid var(--bark);
    box-shadow: 2px 2px 0 var(--bark);
    transition: transform 0.12s, box-shadow 0.12s, background 0.12s;
  }

  .tier-action-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--bark);
  }

  .tier-action-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 0 0 0;
  }

  /* Divider */
  .support-divider {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 16px 0 12px 0;
  }

  .divider-line {
    flex: 1;
    height: 0;
    border-top: 2px dashed var(--bark);
  }

  .divider-text {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    color: #ffffff;
    background: var(--pink);
    border: 1.5px solid var(--bark);
    box-shadow: 2px 2px 0 var(--bark);
    padding: 2px 8px;
    border-radius: 2px;
    letter-spacing: 0.05em;
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Payoneer Box */
  .payoneer-box {
    background: var(--bg-card);
    border: 2.5px solid var(--bark);
    box-shadow: 3.5px 3.5px 0 var(--bark);
    border-radius: 3px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    cursor: pointer;
    transition: transform 0.15s var(--ease-bounce), box-shadow 0.15s var(--ease-bounce), background 0.15s;
  }

  .payoneer-box:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5.5px 5.5px 0 var(--bark);
  }

  .payoneer-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .payoneer-label {
    font-size: 0.72rem;
    color: var(--bark);
    font-weight: 700;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .payoneer-fee-tag {
    font-size: 0.68rem;
    color: #ffffff;
    background: var(--green);
    border: 1.5px solid var(--bark);
    padding: 1px 6px;
    border-radius: 2px;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .payoneer-id-display {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg);
    border: 2px solid var(--bark);
    border-radius: 2px;
    padding: 6px 8px 6px 12px;
  }

  .payoneer-id-value {
    font-size: 1.18rem;
    font-weight: 800;
    color: var(--bark);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }

  .payoneer-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--bark);
    border: 2px solid var(--bark);
    box-shadow: 2px 2px 0 var(--bark);
    color: #ffffff;
    font-size: 0.74rem;
    font-weight: 700;
    font-family: var(--font-mono);
    padding: 5px 10px;
    border-radius: 2px;
    cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s, background 0.12s;
  }

  .payoneer-copy-btn:hover {
    background: var(--pink);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--bark);
  }

  .payoneer-copy-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 0 0 0;
  }

  .payoneer-tip {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.03);
    border: 1.5px dashed var(--bark);
    border-radius: 2px;
    padding: 6px 8px;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .tip-bulb {
    font-size: 0.78rem;
  }

  .gold-id {
    color: var(--bark);
    font-weight: 800;
    background: var(--yellow);
    padding: 0 4px;
    border-radius: 2px;
  }

  /* Footer */
  .support-modal-footer {
    margin-top: 14px;
    text-align: center;
  }

  .footer-thankyou {
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--pink);
  }

  /* Toast Notification */
  .support-toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: none;
  }

  :global(.support-toast) {
    padding: 8px 14px;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bark);
    background: var(--yellow);
    border: 2.5px solid var(--bark);
    box-shadow: 4px 4px 0 var(--bark);
    pointer-events: auto;
    animation: toast-in 0.2s var(--ease-bounce) forwards;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  :global(.support-toast--success) {
    background: #a3e635;
  }

  :global(.support-toast.fade-out) {
    opacity: 0;
    transform: translateY(10px);
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 520px) {
    .support-modal-body {
      padding: 16px 12px;
    }
    .support-tier-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .tier-action-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  function setupSupportModal() {
    const backdrop = document.getElementById('support-modal-backdrop');
    const closeBtn = document.getElementById('support-modal-close');
    const openBtn = document.getElementById('btn-open-support');
    const payoneerBox = document.getElementById('btn-copy-payoneer');
    const payoneerCopyBtn = document.getElementById('btn-payoneer-copy-action');
    const copyLabel = document.getElementById('payoneer-copy-label');

    function openModal() {
      if (!backdrop) return;
      backdrop.classList.add('open');
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!backdrop) return;
      backdrop.classList.remove('open');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function showToast(message: string, type: 'success' | 'info' = 'info') {
      const container = document.getElementById('support-toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = `support-toast support-toast--${type}`;
      toast.textContent = message;
      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.add('fade-out');
        setTimeout(() => toast.remove(), 250);
      }, 3000);
    }

    async function copyPayoneerId(e?: Event) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      try {
        await navigator.clipboard.writeText('24076084');
        if (copyLabel) copyLabel.textContent = 'Copied!';
        showToast('📋 Copied Payoneer ID: 24076084', 'success');
        setTimeout(() => {
          if (copyLabel) copyLabel.textContent = 'Copy ID';
        }, 2000);
      } catch {
        showToast('Payoneer ID: 24076084', 'info');
      }
    }

    // Attach listeners cleanly
    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    payoneerBox?.addEventListener('click', copyPayoneerId);
    payoneerCopyBtn?.addEventListener('click', copyPayoneerId);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop?.classList.contains('open')) {
        closeModal();
      }
    });
  }

  setupSupportModal();
  document.addEventListener('astro:page-load', setupSupportModal);
</script>
