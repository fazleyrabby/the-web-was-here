</style>

<script>
  import { playDialUpSound, stopDialUp, isSoundMuted, toggleSoundMute, playChimeSound } from '../lib/sound';

  function initRetroCrtHero() {
    const screen = document.getElementById('crt-screen');
    const win95Desktop = document.getElementById('win95-desktop');
    const netscapeBrowser = document.getElementById('netscape-browser');
    const modemAnim = document.getElementById('modem-anim');
    const statusMsg = document.getElementById('dialup-status-msg');
    const progressBar = document.getElementById('dialup-progress-bar');
    const btnDial = document.getElementById('btn-dial-connect');
    const btnSkip = document.getElementById('btn-skip-dial');
    const redialBtn = document.getElementById('crt-redial-btn');
    const redialText = document.getElementById('crt-redial-text');
    const soundToggleBtn = document.getElementById('crt-sound-toggle-btn');
    const soundLabel = document.getElementById('crt-sound-label');
    const powerBtn = document.getElementById('crt-power-btn');
    const powerLed = document.getElementById('crt-power-led');

    // LEDs
    const ledMr = document.getElementById('led-mr');
    const ledTr = document.getElementById('led-tr');
    const ledCd = document.getElementById('led-cd');
    const ledSd = document.getElementById('led-sd');
    const ledRd = document.getElementById('led-rd');

    // Netscape elements
    const netscapeLogo = document.getElementById('netscape-logo');
    const nsReloadBtn = document.getElementById('ns-btn-reload');
    const nsStatusMsg = document.getElementById('ns-status-msg');
    const nsTransferProgress = document.getElementById('ns-transfer-progress');

    // Search query elements
    const avQueryInput = document.getElementById('av-query-input') as HTMLInputElement | null;
    const avBtnSearch = document.getElementById('av-btn-search');
    const avBtnSurprise = document.getElementById('av-btn-surprise');

    if (!screen || !win95Desktop || !netscapeBrowser) return;

    let isDialing = false;
    let isConnected = false;
    let isPoweredOn = true;
    let stopModemSound: (() => void) | null = null;

    // Initialize sound mute label
    function updateSoundUi() {
      const muted = isSoundMuted();
      if (soundLabel) {
        soundLabel.textContent = muted ? 'SOUND: OFF' : 'SOUND: ON';
      }
      if (soundToggleBtn) {
        soundToggleBtn.classList.toggle('is-muted', muted);
      }
    }
    updateSoundUi();

    if (soundToggleBtn) {
      soundToggleBtn.onclick = (e) => {
        e.stopPropagation();
        toggleSoundMute();
        updateSoundUi();
      };
    }

    // Toggle power
    if (powerBtn && powerLed) {
      powerBtn.onclick = (e) => {
        e.stopPropagation();
        isPoweredOn = !isPoweredOn;
        if (!isPoweredOn) {
          screen.classList.add('is-off');
          powerLed.classList.remove('crt-power-led--on');
          if (stopModemSound) stopModemSound();
          stopDialUp();
          isDialing = false;
        } else {
          screen.classList.remove('is-off');
          powerLed.classList.add('crt-power-led--on');
        }
      };
    }

    // Dial-up state machine
    function startDialUpSequence() {
      if (isDialing) return;
      isDialing = true;
      isConnected = false;

      // Show desktop & dialup modal
      win95Desktop.classList.remove('is-hidden');
      netscapeBrowser.classList.remove('is-active');
      screen.classList.add('is-connecting');

      if (redialText) redialText.textContent = 'DIALING...';
      if (statusMsg) statusMsg.textContent = 'Dialing 1-800-424-9299...';
      if (progressBar) progressBar.style.width = '15%';

      if (modemAnim) modemAnim.classList.add('is-active');

      // Modem lights sequence
      if (ledMr) ledMr.classList.add('is-lit');
      if (ledTr) ledTr.classList.add('is-lit');
      if (ledCd) ledCd.classList.remove('is-lit');
      if (ledSd) ledSd.classList.add('is-lit');
      if (ledRd) ledRd.classList.remove('is-lit');

      // Play modem synthesizer
      stopModemSound = playDialUpSound((status) => {
        if (!isDialing) return;

        if (status === 'DIALING...') {
          if (statusMsg) statusMsg.textContent = 'Dialing 1-800-424-9299...';
          if (progressBar) progressBar.style.width = '25%';
          if (ledSd) ledSd.classList.toggle('is-lit');
        } else if (status === 'NEGOTIATING CARRIER...') {
          if (statusMsg) statusMsg.textContent = 'Negotiating V.90 56,000 bps carrier...';
          if (progressBar) progressBar.style.width = '60%';
          if (ledCd) ledCd.classList.add('is-lit');
          if (ledRd) ledRd.classList.add('is-lit');
        } else if (status === 'CONNECTED @ 56,000 BPS!' || status === 'ONLINE') {
          handleConnectionSuccess();
        }
      });

      // Fallback timer in case audio is muted or completed
      setTimeout(() => {
        if (isDialing && !isConnected) {
          handleConnectionSuccess();
        }
      }, 5500);
    }

    function handleConnectionSuccess() {
      if (isConnected) return;
      isConnected = true;
      isDialing = false;

      if (statusMsg) statusMsg.textContent = 'Connected at 57,600 bps!';
      if (progressBar) progressBar.style.width = '100%';
      screen.classList.remove('is-connecting');

      if (ledCd) ledCd.classList.add('is-lit');
      if (ledRd) ledRd.classList.add('is-lit');
      if (ledSd) ledSd.classList.add('is-lit');

      // Chime
      playChimeSound();

      // Launch Netscape
      setTimeout(() => {
        launchNetscape();
      }, 750);
    }

    function launchNetscape() {
      win95Desktop.classList.add('is-hidden');
      netscapeBrowser.classList.add('is-active');

      if (redialText) redialText.textContent = 'RE-DIAL 56K';

      // Start Netscape Loading simulation
      if (netscapeLogo) netscapeLogo.classList.add('is-loading');
      if (nsStatusMsg) nsStatusMsg.textContent = 'Transferring: 14.8 KB from www.altavista.digital.com...';
      if (nsTransferProgress) nsTransferProgress.style.width = '40%';

      setTimeout(() => {
        if (nsTransferProgress) nsTransferProgress.style.width = '80%';
        if (nsStatusMsg) nsStatusMsg.textContent = 'Rendering HTML layout and hyperlinks...';
      }, 400);

      setTimeout(() => {
        if (netscapeLogo) netscapeLogo.classList.remove('is-loading');
        if (nsStatusMsg) nsStatusMsg.textContent = 'Document: Done (14.8 KB)';
        if (nsTransferProgress) nsTransferProgress.style.width = '100%';
      }, 850);
    }

    // Connect button click
    if (btnDial) {
      btnDial.onclick = () => startDialUpSequence();
    }

    // Skip directly to Netscape
    if (btnSkip) {
      btnSkip.onclick = () => {
        if (stopModemSound) stopModemSound();
        stopDialUp();
        isDialing = false;
        launchNetscape();
      };
    }

    // Hardware Re-dial Button & Netscape Reload button
    if (redialBtn) {
      redialBtn.onclick = (e) => {
        e.stopPropagation();
        if (stopModemSound) stopModemSound();
        stopDialUp();
        isDialing = false;
        startDialUpSequence();
      };
    }
    if (nsReloadBtn) {
      nsReloadBtn.onclick = (e) => {
        e.stopPropagation();
        startDialUpSequence();
      };
    }

    // Search bar functionality
    function handleSearch() {
      if (!avQueryInput) return;
      const val = avQueryInput.value.trim().toLowerCase();
      // Match 4-digit years like 1998, 2007
      const yearMatch = val.match(/\b(199\d|20[0-2]\d)\b/);
      if (yearMatch) {
        window.location.href = `/the-web/${yearMatch[1]}`;
      } else {
        // Jump to explore or random
        const years = [1995, 1998, 2001, 2005, 2007, 2010, 2015, 2020];
        const randomYear = years[Math.floor(Math.random() * years.length)];
        window.location.href = `/the-web/${randomYear}`;
      }
    }

    if (avBtnSearch) {
      avBtnSearch.onclick = handleSearch;
    }
    if (avQueryInput) {
      avQueryInput.onkeydown = (e) => {
        if (e.key === 'Enter') handleSearch();
      };
    }
    if (avBtnSurprise) {
      avBtnSurprise.onclick = () => {
        const years = [1990, 1995, 1998, 2001, 2005, 2007, 2010, 2015, 2020, 2024];
        const target = years[Math.floor(Math.random() * years.length)];
        window.location.href = `/the-web/${target}`;
      };
    }

    // Initial state: Start on Netscape or Auto-demo connection once
    // If the user hasn't connected yet, let's start with Netscape visible so the page looks gorgeous immediately,
    // and when they click "RE-DIAL 56K" or "Dial & Connect", it plays the full sequence!
    launchNetscape();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRetroCrtHero);
  } else {
    initRetroCrtHero();
  }
  document.addEventListener('astro:page-load', initRetroCrtHero);
</script>
