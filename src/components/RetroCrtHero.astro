---
// Retro CRT Monitor with interactive 56k Dial-Up and Netscape Navigator simulation
---

<div class="crt-chassis" id="twwh-crt-chassis">
  <!-- Top vents -->
  <div class="crt-vents" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  <!-- Main CRT Monitor Bezel -->
  <div class="crt-bezel">
    <!-- Monitor Screen Area with glass curvature & scanlines -->
    <div class="crt-screen-housing">
      <div class="crt-screen" id="crt-screen">

        <!-- LAYER 1: WINDOWS 95 DESKTOP & DIAL-UP NETWORKING MODAL -->
        <div class="win95-desktop" id="win95-desktop">
          <!-- Desktop Icons -->
          <div class="win95-icons" aria-hidden="true">
            <div class="win95-icon">
              <span class="win95-icon__img">🌐</span>
              <span class="win95-icon__label">The Internet</span>
            </div>
            <div class="win95-icon">
              <span class="win95-icon__img">📞</span>
              <span class="win95-icon__label">Dial-Up</span>
            </div>
            <div class="win95-icon">
              <span class="win95-icon__img">🧭</span>
              <span class="win95-icon__label">Netscape</span>
            </div>
            <div class="win95-icon">
              <span class="win95-icon__img">🗑️</span>
              <span class="win95-icon__label">Recycle Bin</span>
            </div>
          </div>

          <!-- DIAL-UP MODAL WINDOW -->
          <div class="win95-window" id="dialup-modal">
            <div class="win95-window__titlebar">
              <div class="win95-window__title">
                <span class="win95-icon-sm">📞</span>
                <span id="dialup-title-text">Connect To: The Web Archive</span>
              </div>
              <div class="win95-window__controls" aria-hidden="true">
                <button type="button" class="win95-btn-box">?</button>
                <button type="button" class="win95-btn-box">×</button>
              </div>
            </div>

            <div class="win95-window__body">
              <!-- Animated Phone / Modem Handshake illustration -->
              <div class="modem-anim" id="modem-anim">
                <div class="modem-anim__node">
                  <span class="node-icon">💻</span>
                  <span class="node-label">Your PC</span>
                </div>
                <div class="modem-anim__line">
                  <div class="modem-anim__packet" id="modem-packet"></div>
                  <span class="modem-anim__speed" id="modem-speed-label">56,000 bps</span>
                </div>
                <div class="modem-anim__node">
                  <span class="node-icon" id="server-icon">📡</span>
                  <span class="node-label">Web Gateway</span>
                </div>
              </div>

              <!-- Connection Status Info -->
              <div class="dialup-status-box">
                <div class="dialup-status-row">
                  <span class="dialup-label">Status:</span>
                  <span class="dialup-value dialup-value--highlight" id="dialup-status-msg">Ready to connect...</span>
                </div>
                <div class="dialup-status-row">
                  <span class="dialup-label">Phone:</span>
                  <span class="dialup-value">1-800-424-9299</span>
                </div>
                <div class="dialup-status-row">
                  <span class="dialup-label">Modem:</span>
                  <span class="dialup-value">USRobotics Sportster 56K V.90</span>
                </div>
              </div>

              <!-- Connection Progress Bar -->
              <div class="win95-progress-outer">
                <div class="win95-progress-bar" id="dialup-progress-bar"></div>
              </div>

              <!-- Modem LED Indicators -->
              <div class="modem-leds">
                <div class="modem-led-group">
                  <span class="modem-led modem-led--green" id="led-mr"></span>
                  <span class="modem-led-label">MR</span>
                </div>
                <div class="modem-led-group">
                  <span class="modem-led modem-led--green" id="led-tr"></span>
                  <span class="modem-led-label">TR</span>
                </div>
                <div class="modem-led-group">
                  <span class="modem-led modem-led--red" id="led-cd"></span>
                  <span class="modem-led-label">CD</span>
                </div>
                <div class="modem-led-group">
                  <span class="modem-led modem-led--red" id="led-sd"></span>
                  <span class="modem-led-label">SD</span>
                </div>
                <div class="modem-led-group">
                  <span class="modem-led modem-led--green" id="led-rd"></span>
                  <span class="modem-led-label">RD</span>
                </div>
              </div>

              <!-- Dialog Action Buttons -->
              <div class="win95-window__actions">
                <button type="button" class="win95-btn win95-btn--primary" id="btn-dial-connect">
                  <span class="btn-icon">📞</span> Dial & Connect
                </button>
                <button type="button" class="win95-btn" id="btn-skip-dial">
                  Skip &rarr;
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- LAYER 2: NETSCAPE NAVIGATOR BROWSER -->
        <div class="netscape-browser" id="netscape-browser">
          <!-- Window Title Bar -->
          <div class="win95-window__titlebar netscape-titlebar">
            <div class="win95-window__title">
              <span class="win95-icon-sm">🧭</span>
              <span>Netscape Navigator - [AltaVista: The Web Was Here Archive]</span>
            </div>
            <div class="win95-window__controls" aria-hidden="true">
              <button type="button" class="win95-btn-box">_</button>
              <button type="button" class="win95-btn-box">□</button>
              <button type="button" class="win95-btn-box">×</button>
            </div>
          </div>

          <!-- Menu Bar -->
          <div class="netscape-menubar" aria-hidden="true">
            <span><u>F</u>ile</span>
            <span><u>E</u>dit</span>
            <span><u>V</u>iew</span>
            <span><u>G</u>o</span>
            <span><u>B</u>ookmarks</span>
            <span><u>O</u>ptions</span>
            <span><u>D</u>irectory</span>
            <span><u>H</u>elp</span>
          </div>

          <!-- Toolbar with Netscape Buttons & Animated N Comet -->
          <div class="netscape-toolbar">
            <div class="netscape-buttons">
              <button type="button" class="ns-tool-btn" id="ns-btn-back" title="Back">
                <span class="ns-tool-icon">⬅️</span>
                <span class="ns-tool-text">Back</span>
              </button>
              <button type="button" class="ns-tool-btn" id="ns-btn-forward" title="Forward">
                <span class="ns-tool-icon">➡️</span>
                <span class="ns-tool-text">Forward</span>
              </button>
              <button type="button" class="ns-tool-btn" id="ns-btn-home" title="Home">
                <span class="ns-tool-icon">🏠</span>
                <span class="ns-tool-text">Home</span>
              </button>
              <button type="button" class="ns-tool-btn" id="ns-btn-reload" title="Reload / Re-dial">
                <span class="ns-tool-icon">🔄</span>
                <span class="ns-tool-text">Reload</span>
              </button>
              <button type="button" class="ns-tool-btn" id="ns-btn-images" title="Images">
                <span class="ns-tool-icon">🖼️</span>
                <span class="ns-tool-text">Images</span>
              </button>
              <button type="button" class="ns-tool-btn" id="ns-btn-print" title="Print">
                <span class="ns-tool-icon">🖨️</span>
                <span class="ns-tool-text">Print</span>
              </button>
              <button type="button" class="ns-tool-btn" id="ns-btn-find" title="Find">
                <span class="ns-tool-icon">🔍</span>
                <span class="ns-tool-text">Find</span>
              </button>
              <button type="button" class="ns-tool-btn" id="ns-btn-stop" title="Stop">
                <span class="ns-tool-icon">🛑</span>
                <span class="ns-tool-text">Stop</span>
              </button>
            </div>

            <!-- Iconic Netscape Animated "N" Logo -->
            <div class="netscape-logo-box" id="netscape-logo" title="Netscape Navigator">
              <div class="netscape-comets" id="netscape-comets">
                <span class="comet comet-1"></span>
                <span class="comet comet-2"></span>
                <span class="comet comet-3"></span>
              </div>
              <div class="netscape-n-graphic">
                <span class="ns-n-letter">N</span>
                <div class="ns-n-ship">⛵</div>
              </div>
            </div>
          </div>

          <!-- Location Bar -->
          <div class="netscape-locationbar">
            <span class="ns-loc-label">Netsite:</span>
            <div class="ns-loc-input-wrap">
              <input
                type="text"
                class="ns-loc-input"
                id="ns-url-input"
                value="http://www.altavista.digital.com/cgi-bin/query?q=the+web+was+here"
                readonly
              />
            </div>
          </div>

          <!-- Webpage Viewport: AltaVista 1996 Search Results -->
          <div class="netscape-viewport" id="netscape-viewport">
            <div class="altavista-header">
              <div class="altavista-brand">
                <span class="av-logo">AltaVista</span>
                <span class="av-tagline">The Search Engine of the World Wide Web</span>
              </div>
              <div class="av-search-form">
                <input
                  type="text"
                  id="av-query-input"
                  class="av-search-input"
                  value="history of the internet 1990-2026"
                  placeholder="Search years (e.g. 1998, 2007)..."
                />
                <button type="button" class="av-search-btn" id="av-btn-search">Search</button>
                <button type="button" class="av-search-btn" id="av-btn-surprise">Surprise</button>
              </div>
            </div>

            <!-- Search Meta -->
            <div class="av-results-meta">
              <span>AltaVista found <strong>37 document(s)</strong> in 0.38 seconds. Displaying internet milestones:</span>
            </div>

            <!-- Search Results List -->
            <div class="av-results-list" id="av-results-list">
              <!-- Result 1 -->
              <article class="av-result">
                <h3 class="av-result__title">
                  <a href="/the-web/1995" class="av-result__link">1995: The Year the Web Exploded (Netscape IPO & JavaScript)</a>
                </h3>
                <p class="av-result__snippet">
                  Marc Andreessen launches Netscape Navigator 1.0. Brendan Eich writes JavaScript in 10 days. The browser wars ignite and the world hops online via dial-up modems...
                </p>
                <div class="av-result__meta">
                  <span class="av-result__url">http://thewebwashere.com/the-web/1995</span>
                  <span class="av-result__date">&bull; Year 1995 &bull; 14.8KB</span>
                </div>
              </article>

              <!-- Result 2 -->
              <article class="av-result">
                <h3 class="av-result__title">
                  <a href="/the-web/1998" class="av-result__link">1998: Google Born in a Menlo Park Garage</a>
                </h3>
                <p class="av-result__snippet">
                  Larry Page and Sergey Brin unleash PageRank on Stanford servers. Netscape goes open-source to spawn Mozilla while Microsoft IE 4 bundles into Windows 98...
                </p>
                <div class="av-result__meta">
                  <span class="av-result__url">http://thewebwashere.com/the-web/1998</span>
                  <span class="av-result__date">&bull; Year 1998 &bull; 18.2KB</span>
                </div>
              </article>

              <!-- Result 3 -->
              <article class="av-result">
                <h3 class="av-result__title">
                  <a href="/the-web/2007" class="av-result__link">2007: Steve Jobs & The Mobile Web Revolution</a>
                </h3>
                <p class="av-result__snippet">
                  "An iPod, a phone, and an Internet communicator." Apple unveils the iPhone, Twitter blows up at SXSW, and modern web browsing moves right into our pockets...
                </p>
                <div class="av-result__meta">
                  <span class="av-result__url">http://thewebwashere.com/the-web/2007</span>
                  <span class="av-result__date">&bull; Year 2007 &bull; 21.0KB</span>
                </div>
              </article>

              <!-- Result 4 -->
              <article class="av-result">
                <h3 class="av-result__title">
                  <a href="/the-web/2005" class="av-result__link">2005: "Me at the zoo" — Dawn of Web 2.0 & YouTube</a>
                </h3>
                <p class="av-result__snippet">
                  Jawed Karim uploads the very first 19-second video to YouTube. Reddit, MySpace, and AJAX dynamic interfaces redefine cyberspace into user-generated content...
                </p>
                <div class="av-result__meta">
                  <span class="av-result__url">http://thewebwashere.com/the-web/2005</span>
                  <span class="av-result__date">&bull; Year 2005 &bull; 16.4KB</span>
                </div>
              </article>
            </div>
          </div>

          <!-- Bottom Status Bar -->
          <div class="netscape-statusbar">
            <div class="ns-status-left">
              <span class="ns-status-lock" title="Security: Unencrypted HTTP 1.0">🔓</span>
              <span class="ns-status-msg" id="ns-status-msg">Document: Done (14.2 KB)</span>
            </div>
            <div class="ns-status-progress">
              <div class="ns-status-fill" id="ns-transfer-progress"></div>
            </div>
          </div>
        </div>

        <!-- CRT Tube Scanlines & Phosphor Overlays -->
        <div class="crt-scanlines" aria-hidden="true"></div>
        <div class="crt-glow" aria-hidden="true"></div>
        <div class="crt-glass-reflection" aria-hidden="true"></div>

        <!-- Power Off Screen Effect Layer -->
        <div class="crt-off-overlay" id="crt-off-overlay"></div>
      </div>
    </div>

    <!-- CRT Monitor Bottom Control Bezel -->
    <div class="crt-controls-bezel">
      <div class="crt-badge">
        <span class="crt-brand">TWWH</span>
        <span class="crt-model">MULTISYNC 17GX</span>
      </div>

      <div class="crt-physical-buttons">
        <!-- Re-Dial Button -->
        <button type="button" class="crt-dial-toggle-btn" id="crt-redial-btn" title="Re-run 56k Dial-Up sequence">
          <span class="crt-dial-btn-icon">📞</span>
          <span id="crt-redial-text">RE-DIAL 56K</span>
        </button>

        <!-- Sound FX Button -->
        <button type="button" class="crt-sound-btn" id="crt-sound-toggle-btn" title="Toggle 56k Modem Sound FX">
          <span class="crt-sound-icon" id="crt-sound-icon">🔊</span>
          <span id="crt-sound-label">SOUND: ON</span>
        </button>

        <!-- Dials decoration -->
        <div class="crt-dials" aria-hidden="true">
          <div class="crt-dial" title="Brightness Dial"></div>
          <div class="crt-dial" title="Contrast Dial"></div>
        </div>

        <!-- Power Button with LED -->
        <div class="crt-power-group">
          <span class="crt-power-led crt-power-led--on" id="crt-power-led" title="Power On"></span>
          <button type="button" class="crt-power-btn" id="crt-power-btn" title="Toggle CRT Power">
            PWR
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- CRT Monitor Stand Base -->
  <div class="crt-stand" aria-hidden="true">
    <div class="crt-stand__neck"></div>
    <div class="crt-stand__foot"></div>
  </div>
</div>

<style>
  /* =========================================
     CRT CHASSIS & VINTAGE HARDWARE HOUSING
     ========================================= */
  .crt-chassis {
    width: 100%;
    max-width: 530px;
    margin: 0 auto;
    position: relative;
    user-select: none;
  }

  .crt-vents {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding-bottom: 4px;
  }
  .crt-vents span {
    display: block;
    width: 32px;
    height: 4px;
    background: #b5ada2;
    border-radius: 2px;
    box-shadow: inset 0 1px 1px rgba(0,0,0,0.3);
  }

  .crt-bezel {
    background: #d8d1c5;
    background: linear-gradient(145deg, #e4ddd1 0%, #cdc6b9 100%);
    border: 4px solid var(--bark);
    border-radius: 12px 12px 16px 16px;
    box-shadow: 8px 8px 0 var(--bark), inset 0 2px 3px rgba(255,255,255,0.7);
    padding: 14px 14px 12px 14px;
    position: relative;
    transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }
  .crt-bezel:hover {
    transform: translate(-2px, -2px);
    box-shadow: 10px 10px 0 var(--bark);
  }

  /* Screen Housing (Dark Bevel surrounding curved tube) */
  .crt-screen-housing {
    background: #1e1d1a;
    border: 3px solid #383531;
    border-radius: 8px;
    padding: 6px;
    box-shadow: inset 0 4px 12px rgba(0,0,0,0.8), 0 1px 2px rgba(255,255,255,0.4);
  }

  .crt-screen {
    background: #000;
    border-radius: 6px;
    position: relative;
    height: 340px;
    overflow: hidden;
    color: #111;
    font-family: var(--font-mono), monospace;
  }

  @media (max-width: 640px) {
    .crt-screen {
      height: 310px;
    }
  }

  /* CRT Scanlines, Curve Glow & Glass Reflection */
  .crt-scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      rgba(0, 0, 0, 0) 0px,
      rgba(0, 0, 0, 0) 2px,
      rgba(0, 0, 0, 0.24) 2px,
      rgba(0, 0, 0, 0.24) 4px
    );
    z-index: 20;
    mix-blend-mode: multiply;
  }

  .crt-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 45px rgba(0, 0, 0, 0.65), inset 0 0 10px rgba(0, 160, 255, 0.1);
    z-index: 21;
  }

  .crt-glass-reflection {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.03) 30%,
      rgba(255, 255, 255, 0) 60%
    );
    z-index: 22;
  }

  /* Power Off Effect */
  .crt-off-overlay {
    position: absolute;
    inset: 0;
    background: #0a0a0a;
    opacity: 0;
    pointer-events: none;
    z-index: 30;
    transition: opacity 0.2s ease;
  }
  .crt-screen.is-off .crt-off-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  /* Screen Flicker when connecting */
  .crt-screen.is-connecting {
    animation: crtStaticPulse 0.12s infinite alternate;
  }
  @keyframes crtStaticPulse {
    0% { filter: brightness(1) contrast(1); }
    100% { filter: brightness(1.12) contrast(1.08) saturate(1.1); }
  }

  /* =========================================
     LAYER 1: WINDOWS 95 DESKTOP & DIAL-UP
     ========================================= */
  .win95-desktop {
    position: absolute;
    inset: 0;
    background: #008080;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 5;
  }
  .win95-desktop.is-hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.96);
  }

  .win95-icons {
    position: absolute;
    top: 8px;
    left: 8px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 1;
  }
  .win95-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 52px;
    text-align: center;
    cursor: default;
  }
  .win95-icon__img {
    font-size: 1.4rem;
    filter: drop-shadow(1px 1px 0 rgba(0,0,0,0.5));
  }
  .win95-icon__label {
    font-size: 0.55rem;
    color: #fff;
    text-shadow: 1px 1px 1px #000;
    line-height: 1.1;
    margin-top: 2px;
  }

  /* Windows 95 Classic Window */
  .win95-window {
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    box-shadow: 3px 3px 6px rgba(0,0,0,0.4);
    width: 100%;
    max-width: 350px;
    z-index: 2;
    position: relative;
  }

  .win95-window__titlebar {
    background: linear-gradient(90deg, #000080 0%, #1084d0 100%);
    color: #ffffff;
    padding: 3px 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .win95-window__title {
    display: flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .win95-icon-sm {
    font-size: 0.8rem;
  }

  .win95-window__controls {
    display: flex;
    gap: 2px;
  }
  .win95-btn-box {
    background: #c0c0c0;
    border-top: 1px solid #ffffff;
    border-left: 1px solid #ffffff;
    border-right: 1px solid #404040;
    border-bottom: 1px solid #404040;
    font-size: 0.65rem;
    font-weight: 700;
    width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }

  .win95-window__body {
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  /* Modem Animation Graphic */
  .modem-anim {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border-top: 1.5px solid #808080;
    border-left: 1.5px solid #808080;
    border-right: 1.5px solid #dfdfdf;
    border-bottom: 1.5px solid #dfdfdf;
    padding: 6px 12px;
  }
  .modem-anim__node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .node-icon {
    font-size: 1.3rem;
  }
  .node-label {
    font-size: 0.55rem;
    color: #333;
    font-weight: 600;
  }

  .modem-anim__line {
    flex: 1;
    margin: 0 12px;
    height: 3px;
    background: #b0b0b0;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .modem-anim__packet {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff0000;
    box-shadow: 0 0 5px #ff0000;
    left: 0%;
    opacity: 0;
  }
  .modem-anim.is-active .modem-anim__packet {
    opacity: 1;
    animation: packetTravel 0.8s infinite linear;
  }
  @keyframes packetTravel {
    0% { left: 0%; background: #ff0000; }
    50% { background: #ffaa00; }
    100% { left: 95%; background: #00ff00; }
  }

  .modem-anim__speed {
    position: absolute;
    bottom: 5px;
    font-size: 0.52rem;
    color: #444;
    font-weight: 700;
    white-space: nowrap;
  }

  /* Status details inside modal */
  .dialup-status-box {
    font-size: 0.62rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .dialup-status-row {
    display: flex;
    gap: 6px;
  }
  .dialup-label {
    color: #444;
    width: 52px;
    flex-shrink: 0;
    font-weight: 600;
  }
