---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`robot-stage ${className}`.trim()} data-robot>
  <div class="robot-stage__glow" aria-hidden="true"></div>
  <div class="robot-stage__fallback" data-robot-fallback>
    <slot name="fallback" />
  </div>
  <canvas class="robot-stage__canvas" data-robot-canvas aria-hidden="true"></canvas>
</div>

<style>
  .robot-stage {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .robot-stage__glow {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.85;
    filter: blur(34px);
    background:
      radial-gradient(circle at 40% 34%, rgba(255, 40, 24, 0.5), transparent 58%),
      radial-gradient(circle at 66% 66%, rgba(80, 120, 255, 0.4), transparent 62%),
      radial-gradient(circle at 52% 50%, rgba(120, 20, 40, 0.4), transparent 66%);
    animation: robotGlow 7s ease-in-out infinite alternate;
  }

  @keyframes robotGlow {
    from { transform: scale(0.95); opacity: 0.65; }
    to { transform: scale(1.06); opacity: 0.95; }
  }

  .robot-stage__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    z-index: 1;
    transition: opacity 0.6s var(--ease-out, ease);
  }

  .robot-stage__canvas {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.7s var(--ease-out, ease);
  }

  .robot-stage--ready .robot-stage__canvas { opacity: 1; }
  .robot-stage--ready .robot-stage__fallback { opacity: 0; pointer-events: none; }
  .robot-stage--failed .robot-stage__canvas,
  .robot-stage--failed .robot-stage__glow { display: none; }

  @media (max-width: 480px) {
    .robot-stage { max-width: 260px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .robot-stage__glow { animation: none; }
  }
</style>

<script>
  type ThreeModule = typeof import('three');

  const ROBOT_SELECTOR = '[data-robot]';
  const cleanups = new WeakMap<HTMLElement, () => void>();

  let threePromise: Promise<ThreeModule> | null = null;
  function loadThree(): Promise<ThreeModule> {
    if (!threePromise) threePromise = import('three');
    return threePromise;
  }

  function webglAvailable(): boolean {
    try {
      const c = document.createElement('canvas');
      return !!(window.WebGLRenderingContext && (c.getContext('webgl2') || c.getContext('webgl')));
    } catch {
      return false;
    }
  }

  function makeStudioEnv(THREE: ThreeModule) {
    const c = document.createElement('canvas');
    c.width = 512;
    c.height = 256;
    const ctx = c.getContext('2d');
    if (ctx) {
      const g = ctx.createLinearGradient(0, 0, 0, 256);
      g.addColorStop(0.0, '#f2f5ff');
      g.addColorStop(0.34, '#5b6577');
      g.addColorStop(0.6, '#20242e');
      g.addColorStop(1.0, '#07080c');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, 512, 256);

      const blobs: [string, number, number, number][] = [
        ['rgba(255,255,255,1)', 256, 24, 90],
        ['rgba(90,140,255,0.95)', 96, 90, 100],
        ['rgba(255,60,40,0.9)', 420, 110, 96],
        ['rgba(120,20,30,0.8)', 256, 210, 120],
      ];
      for (const [col, x, y, r] of blobs) {
        const rg = ctx.createRadialGradient(x, y, 0, x, y, r);
        rg.addColorStop(0, col);
        rg.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = rg;
        ctx.fillRect(0, 0, 512, 256);
      }
    }
    const tex = new THREE.CanvasTexture(c);
    tex.mapping = THREE.EquirectangularReflectionMapping;
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }

  function buildHead(THREE: ThreeModule) {
    const head = new THREE.Group();

    const chrome = new THREE.MeshStandardMaterial({
      color: 0xc3c9d4, metalness: 1.0, roughness: 0.15, envMapIntensity: 1.55,
    });
    const darkMetal = new THREE.MeshStandardMaterial({
      color: 0x6a707b, metalness: 1.0, roughness: 0.34, envMapIntensity: 1.2,
    });
    const blackMat = new THREE.MeshStandardMaterial({
      color: 0x0a0b10, metalness: 0.6, roughness: 0.5,
    });
    const eyeMat = new THREE.MeshStandardMaterial({
      color: 0x2a0300, emissive: 0xff2a12, emissiveIntensity: 2.8, metalness: 0.3, roughness: 0.25,
    });

    const add = (
      mesh: InstanceType<ThreeModule['Mesh']>,
      x: number, y: number, z: number,
      rx = 0, ry = 0, rz = 0,
      parent: InstanceType<ThreeModule['Group']> = head
    ) => {
      mesh.position.set(x, y, z);
      mesh.rotation.set(rx, ry, rz);
      parent.add(mesh);
      return mesh;
    };

    const box = (w: number, h: number, d: number, mat: InstanceType<ThreeModule['Material']>) =>
      new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
    const cyl = (rt: number, rb: number, h: number, mat: InstanceType<ThreeModule['Material']>, seg = 24) =>
      new THREE.Mesh(new THREE.CylinderGeometry(rt, rb, h, seg), mat);

    // Cranium — smooth chrome dome
    const skull = new THREE.Mesh(new THREE.SphereGeometry(0.58, 96, 64), chrome);
    skull.scale.set(1.03, 1.07, 0.96);
    skull.position.y = 0.09;
    head.add(skull);

    // Brow ridge
    add(box(0.99, 0.13, 0.26, chrome), 0, 0.24, 0.4, -0.22);
    // Temple plates
    add(box(0.17, 0.5, 0.5, chrome), -0.5, 0.06, 0.02, 0, 0.08, 0.1);
    add(box(0.17, 0.5, 0.5, chrome), 0.5, 0.06, 0.02, 0, -0.08, -0.1);

    // Eye rig (moves subtly toward cursor)
    const eyeRig = new THREE.Group();
    head.add(eyeRig);

    for (const sx of [-1, 1] as const) {
      add(box(0.3, 0.16, 0.14, blackMat), sx * 0.2, 0.06, 0.44, -0.08, 0, 0, eyeRig);
      add(cyl(0.075, 0.075, 0.05, eyeMat, 32), sx * 0.2, 0.06, 0.5, Math.PI / 2, 0, 0, eyeRig);
      add(new THREE.Mesh(new THREE.SphereGeometry(0.045, 32, 24), eyeMat), sx * 0.2, 0.06, 0.53, 0, 0, 0, eyeRig);
    }

    // Nose / muzzle vent
    add(box(0.12, 0.3, 0.16, darkMetal), 0, -0.07, 0.5, 0.15);
    // Cheek plates
    add(box(0.16, 0.32, 0.32, chrome), -0.3, -0.17, 0.3, 0.12, 0.36, 0);
    add(box(0.16, 0.32, 0.32, chrome), 0.3, -0.17, 0.3, 0.12, -0.36, 0);
    // Jaw + chin
    add(box(0.6, 0.18, 0.42, chrome), 0, -0.42, 0.3, 0.04);
    add(box(0.4, 0.12, 0.3, darkMetal), 0, -0.5, 0.36, 0.08);
    // Teeth
    for (let i = 0; i < 8; i++) {
      const x = -0.21 + i * 0.06;
      add(box(0.045, 0.06, 0.05, blackMat), x, -0.315, 0.47, 0.04);
    }
    // Ear / side vents
    for (const sx of [-1, 1] as const) {
      add(cyl(0.13, 0.13, 0.1, darkMetal, 32), sx * 0.56, 0.05, 0.02, 0, 0, Math.PI / 2);
      add(cyl(0.05, 0.05, 0.12, eyeMat, 24), sx * 0.6, 0.05, 0.02, 0, 0, Math.PI / 2);
    }
    // Neck + pistons
    add(cyl(0.15, 0.19, 0.28, darkMetal, 32), 0, -0.72, 0.02, 0.06);
    add(cyl(0.028, 0.028, 0.34, chrome, 16), -0.22, -0.72, 0.02, 0.1, 0, 0.08);
    add(cyl(0.028, 0.028, 0.34, chrome, 16), 0.22, -0.72, 0.02, 0.1, 0, -0.08);

    return { head, eyeRig, eyeMat };
  }

  async function mountRobot(stage: HTMLElement, THREE: ThreeModule): Promise<() => void> {
    const canvas = stage.querySelector<HTMLCanvasElement>('[data-robot-canvas]');
    if (!canvas) return () => {};

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const small = window.innerWidth < 720;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setClearAlpha(0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, small || coarse ? 1.5 : 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.debug.onShaderError = () => {
      stage.classList.remove('robot-stage--ready');
      stage.classList.add('robot-stage--failed');
    };

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
    camera.position.set(0, 0.05, 3.5);
    camera.lookAt(0, -0.02, 0);

    const pmrem = new THREE.PMREMGenerator(renderer);
    const envSrc = makeStudioEnv(THREE);
    const envRT = pmrem.fromEquirectangular(envSrc);
    scene.environment = envRT.texture;
    envSrc.dispose();
    pmrem.dispose();

    const { head, eyeRig, eyeMat } = buildHead(THREE);
    head.position.y = -0.05;
    head.rotation.y = -0.14;
    scene.add(head);

    const key = new THREE.DirectionalLight(0xffffff, 2.6);
    key.position.set(2.4, 2.6, 3.4);
    const fill = new THREE.DirectionalLight(0x8fb0ff, 1.2);
    fill.position.set(-3.2, 0.4, 2.2);
    const rim = new THREE.DirectionalLight(0xff4a3a, 1.8);
    rim.position.set(-1.4, 1.6, -3.4);
    scene.add(key, fill, rim);

    const eyeLightL = new THREE.PointLight(0xff2a12, 2.4, 1.8, 2);
    eyeLightL.position.set(-0.2, 0.06, 0.72);
    const eyeLightR = new THREE.PointLight(0xff2a12, 2.4, 1.8, 2);
    eyeLightR.position.set(0.2, 0.06, 0.72);
    head.add(eyeLightL, eyeLightR);

    function resize() {
      const rect = stage.getBoundingClientRect();
      const w = Math.max(1, Math.round(rect.width));
      const h = Math.max(1, Math.round(rect.height));
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    const ro = new ResizeObserver(resize);
    ro.observe(stage);
    resize();

    // Cursor tracking across the whole page
    let pointerX = 0;
    let pointerY = 0;
    let lastMove = -1e9;
    const onPointerMove = (e: PointerEvent) => {
      pointerX = (e.clientX / window.innerWidth) * 2 - 1;
      pointerY = (e.clientY / window.innerHeight) * 2 - 1;
      lastMove = performance.now();
    };
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    let visible = true;
    const io = new IntersectionObserver(
      (entries) => {
        visible = entries.some((en) => en.isIntersecting);
        if (visible) start();
      },
      { threshold: 0.01 }
    );
    io.observe(stage);

    const t0 = performance.now();
    const current = { x: 0, y: 0 };
    let raf = 0;
    let running = false;

    function frame() {
      raf = requestAnimationFrame(frame);
      if (!visible || document.hidden) return;
      const now = performance.now();
      const t = (now - t0) / 1000;

      const idle = now - lastMove > 1800;
      const tx = idle ? Math.sin(t * 0.5) * 0.4 : pointerX;
      const ty = idle ? Math.sin(t * 0.37) * 0.14 : pointerY;
      current.x += (tx - current.x) * 0.06;
      current.y += (ty - current.y) * 0.06;

      head.rotation.y = -0.14 + current.x * 0.6;
      head.rotation.x = current.y * 0.34 + Math.sin(t * 0.6) * 0.015;
      head.position.y = -0.05 + Math.sin(t * 0.9) * 0.015;

      eyeRig.position.x = current.x * 0.03;
      eyeRig.position.y = -current.y * 0.014;

      eyeMat.emissiveIntensity = 2.5 + Math.sin(t * 3.0) * 0.45 + Math.abs(current.x) * 0.9;

      renderer.render(scene, camera);
    }

    function start() {
      if (running || reduce) return;
      running = true;
      frame();
    }

    function stop() {
      running = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    if (reduce) {
      head.rotation.set(0, -0.14, 0);
      renderer.render(scene, camera);
    } else {
      start();
    }

    const onVisibility = () => {
      if (document.hidden) stop();
      else if (visible) start();
    };
    document.addEventListener('visibilitychange', onVisibility);

    if (!stage.classList.contains('robot-stage--failed')) stage.classList.add('robot-stage--ready');

    return () => {
      stop();
      document.removeEventListener('visibilitychange', onVisibility);
      window.removeEventListener('pointermove', onPointerMove);
      io.disconnect();
      ro.disconnect();
      head.traverse((obj) => {
        const mesh = obj as unknown as { geometry?: { dispose: () => void } };
        if (mesh.geometry) mesh.geometry.dispose();
      });
      for (const mat of [eyeMat]) mat.dispose();
      envRT.dispose();
      renderer.dispose();
    };
  }

  function initRobots() {
    document.querySelectorAll<HTMLElement>(ROBOT_SELECTOR).forEach((stage) => {
      if (stage.dataset.robotInit === '1') return;
      stage.dataset.robotInit = '1';

      if (!webglAvailable()) {
        stage.classList.add('robot-stage--failed');
        return;
      }

      loadThree()
        .then((THREE) => mountRobot(stage, THREE))
        .then((cleanup) => cleanups.set(stage, cleanup))
        .catch((err) => {
          console.warn('[robot-head] init failed', err);
          stage.classList.add('robot-stage--failed');
        });
    });
  }

  function teardownRobots() {
    document.querySelectorAll<HTMLElement>(ROBOT_SELECTOR).forEach((stage) => {
      const cleanup = cleanups.get(stage);
      if (cleanup) cleanup();
      cleanups.delete(stage);
    });
  }

  initRobots();
  document.addEventListener('astro:page-load', initRobots);
  document.addEventListener('astro:before-swap', teardownRobots);
</script>
