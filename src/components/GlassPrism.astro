---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`prism-stage ${className}`.trim()} data-prism>
  <div class="prism-stage__glow" aria-hidden="true"></div>
  <div class="prism-stage__fallback" data-prism-fallback>
    <slot name="fallback" />
  </div>
  <canvas class="prism-stage__canvas" data-prism-canvas aria-hidden="true"></canvas>
</div>

<style>
  .prism-stage {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .prism-stage__glow {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.75;
    filter: blur(40px);
    background:
      radial-gradient(circle at 36% 32%, rgba(178, 156, 255, 0.55), transparent 58%),
      radial-gradient(circle at 68% 62%, rgba(255, 170, 214, 0.5), transparent 60%),
      radial-gradient(circle at 50% 78%, rgba(148, 226, 255, 0.48), transparent 62%);
    animation: prismGlow 10s ease-in-out infinite alternate;
  }

  @keyframes prismGlow {
    from { transform: scale(0.96); opacity: 0.6; }
    to { transform: scale(1.06); opacity: 0.9; }
  }

  .prism-stage__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    z-index: 1;
    transition: opacity 0.6s var(--ease-out, ease);
  }

  .prism-stage__canvas {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.7s var(--ease-out, ease);
  }

  .prism-stage--ready .prism-stage__canvas { opacity: 1; }
  .prism-stage--ready .prism-stage__fallback { opacity: 0; pointer-events: none; }
  .prism-stage--failed .prism-stage__canvas,
  .prism-stage--failed .prism-stage__glow { display: none; }

  @media (max-width: 480px) {
    .prism-stage { max-width: 300px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .prism-stage__glow { animation: none; }
  }
</style>

<script>
  type ThreeModule = typeof import('three');

  const PRISM_SELECTOR = '[data-prism]';
  const cleanups = new WeakMap<HTMLElement, () => void>();

  let threePromise: Promise<ThreeModule> | null = null;
  function loadThree(): Promise<ThreeModule> {
    if (!threePromise) threePromise = import('three');
    return threePromise;
  }

  function webglAvailable(): boolean {
    try {
      const c = document.createElement('canvas');
      return !!(window.WebGLRenderingContext && (c.getContext('webgl2') || c.getContext('webgl')));
    } catch {
      return false;
    }
  }

  function makeStudioEnv(THREE: ThreeModule) {
    const c = document.createElement('canvas');
    c.width = 512;
    c.height = 256;
    const ctx = c.getContext('2d');
    if (ctx) {
      const g = ctx.createLinearGradient(0, 0, 0, 256);
      g.addColorStop(0.0, '#ffffff');
      g.addColorStop(0.34, '#e6ebff');
      g.addColorStop(0.6, '#ffdcef');
      g.addColorStop(0.82, '#d3f0ff');
      g.addColorStop(1.0, '#c2cbff');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, 512, 256);

      const blobs: [string, number, number, number][] = [
        ['rgba(255,255,255,1)', 250, 24, 104],
        ['rgba(150,255,226,0.9)', 90, 104, 108],
        ['rgba(255,178,214,0.9)', 428, 108, 104],
        ['rgba(180,196,255,0.85)', 300, 216, 124],
      ];
      for (const [col, x, y, r] of blobs) {
        const rg = ctx.createRadialGradient(x, y, 0, x, y, r);
        rg.addColorStop(0, col);
        rg.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = rg;
        ctx.fillRect(0, 0, 512, 256);
      }
    }
    const tex = new THREE.CanvasTexture(c);
    tex.mapping = THREE.EquirectangularReflectionMapping;
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }

  function makeBackdropTexture(THREE: ThreeModule) {
    const c = document.createElement('canvas');
    c.width = 256;
    c.height = 256;
    const ctx = c.getContext('2d');
    if (ctx) {
      const g = ctx.createRadialGradient(128, 128, 0, 128, 128, 128);
      g.addColorStop(0.0, 'rgba(196,170,255,0.95)');
      g.addColorStop(0.38, 'rgba(255,170,214,0.7)');
      g.addColorStop(0.68, 'rgba(150,226,255,0.42)');
      g.addColorStop(1.0, 'rgba(255,255,255,0)');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, 256, 256);
    }
    const tex = new THREE.CanvasTexture(c);
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }

  async function mountPrism(stage: HTMLElement, THREE: ThreeModule): Promise<() => void> {
    const canvas = stage.querySelector<HTMLCanvasElement>('[data-prism-canvas]');
    if (!canvas) return () => {};

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const small = window.innerWidth < 720;

    const [{ RoundedBoxGeometry }] = await Promise.all([
      import('three/examples/jsm/geometries/RoundedBoxGeometry.js'),
    ]);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setClearAlpha(0);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, small || coarse ? 1.5 : 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    if ('transmissionResolutionScale' in renderer && (small || coarse)) {
      (renderer as unknown as { transmissionResolutionScale: number }).transmissionResolutionScale = 0.5;
    }

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
    camera.position.set(0, 0, 5.2);

    const pmrem = new THREE.PMREMGenerator(renderer);
    const envSrc = makeStudioEnv(THREE);
    const envRT = pmrem.fromEquirectangular(envSrc);
    scene.environment = envRT.texture;
    envSrc.dispose();
    pmrem.dispose();

    // soft pastel backdrop the glass can refract (fades at the edges)
    const backdropTex = makeBackdropTexture(THREE);
    const backdrop = new THREE.Mesh(
      new THREE.PlaneGeometry(7, 7),
      new THREE.MeshBasicMaterial({ map: backdropTex, transparent: true, depthWrite: false, toneMapped: false })
    );
    backdrop.position.set(0, 0, -2.8);
    scene.add(backdrop);

    const geometry = new RoundedBoxGeometry(1.62, 1.62, 1.62, 8, 0.42);
    const material = new THREE.MeshPhysicalMaterial({
      color: 0xffffff,
      metalness: 0.0,
      roughness: 0.11,
      transmission: 1.0,
      thickness: 2.4,
      ior: 1.46,
      dispersion: 0.7,
      clearcoat: 1.0,
      clearcoatRoughness: 0.08,
      iridescence: 0.55,
      iridescenceIOR: 1.3,
      iridescenceThicknessRange: [100, 500],
      envMapIntensity: 1.35,
      attenuationColor: new THREE.Color('#bfe0ff'),
      attenuationDistance: 3.2,
    });

    const prism = new THREE.Mesh(geometry, material);
    scene.add(prism);

    // a small iridescent core to refract
    const core = new THREE.Mesh(
      new THREE.IcosahedronGeometry(0.34, 2),
      new THREE.MeshPhysicalMaterial({
        color: 0xffffff,
        metalness: 0.0,
        roughness: 0.1,
        iridescence: 1.0,
        iridescenceIOR: 1.5,
        clearcoat: 1.0,
        envMapIntensity: 1.6,
      })
    );
    prism.add(core);

    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(2.4, 2.8, 3.4);
    const rimPink = new THREE.DirectionalLight(0xffa8d6, 1.2);
    rimPink.position.set(-3.0, 0.4, 1.6);
    const rimBlue = new THREE.DirectionalLight(0x9ec4ff, 1.1);
    rimBlue.position.set(2.4, -1.4, -2.4);
    scene.add(key, rimPink, rimBlue);

    function resize() {
      const rect = stage.getBoundingClientRect();
      const w = Math.max(1, Math.round(rect.width));
      const h = Math.max(1, Math.round(rect.height));
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    const ro = new ResizeObserver(resize);
    ro.observe(stage);
    resize();

    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    const onPointer = (e: PointerEvent) => {
      const rect = stage.getBoundingClientRect();
      target.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      target.y = ((e.clientY - rect.top) / rect.height) * 2 - 1;
    };
    const onLeave = () => {
      target.x = 0;
      target.y = 0;
    };
    stage.addEventListener('pointermove', onPointer);
    stage.addEventListener('pointerleave', onLeave);

    let visible = true;
    const io = new IntersectionObserver(
      (entries) => {
        visible = entries.some((en) => en.isIntersecting);
        if (visible) start();
      },
      { threshold: 0.01 }
    );
    io.observe(stage);

    const t0 = performance.now();
    let raf = 0;
    let running = false;

    function frame() {
      raf = requestAnimationFrame(frame);
      if (!visible || document.hidden) return;
      const t = (performance.now() - t0) / 1000;
      current.x += (target.x - current.x) * 0.045;
      current.y += (target.y - current.y) * 0.045;
      prism.rotation.y = t * 0.22 + current.x * 0.55;
      prism.rotation.x = Math.sin(t * 0.35) * 0.35 + current.y * 0.4;
      prism.rotation.z = Math.sin(t * 0.22) * 0.12;
      prism.position.y = Math.sin(t * 0.8) * 0.06;
      core.rotation.y = -t * 0.6;
      core.rotation.x = t * 0.4;
      renderer.render(scene, camera);
    }

    function start() {
      if (running || reduce) return;
      running = true;
      frame();
    }

    function stop() {
      running = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    if (reduce) {
      prism.rotation.set(0.35, 0.6, 0.1);
      renderer.render(scene, camera);
    } else {
      start();
    }

    const onVisibility = () => {
      if (document.hidden) stop();
      else if (visible) start();
    };
    document.addEventListener('visibilitychange', onVisibility);

    if (!stage.classList.contains('prism-stage--failed')) stage.classList.add('prism-stage--ready');

    return () => {
      stop();
      document.removeEventListener('visibilitychange', onVisibility);
      stage.removeEventListener('pointermove', onPointer);
      stage.removeEventListener('pointerleave', onLeave);
      io.disconnect();
      ro.disconnect();
      geometry.dispose();
      material.dispose();
      geometry.dispose();
      backdropTex.dispose();
      envRT.dispose();
      renderer.dispose();
    };
  }

  function initPrisms() {
    document.querySelectorAll<HTMLElement>(PRISM_SELECTOR).forEach((stage) => {
      if (stage.dataset.prismInit === '1') return;
      stage.dataset.prismInit = '1';

      if (!webglAvailable()) {
        stage.classList.add('prism-stage--failed');
        return;
      }

      loadThree()
        .then((THREE) => mountPrism(stage, THREE))
        .then((cleanup) => cleanups.set(stage, cleanup))
        .catch((err) => {
          console.warn('[glass-prism] init failed', err);
          stage.classList.add('prism-stage--failed');
        });
    });
  }

  function teardownPrisms() {
    document.querySelectorAll<HTMLElement>(PRISM_SELECTOR).forEach((stage) => {
      const cleanup = cleanups.get(stage);
      if (cleanup) cleanup();
      cleanups.delete(stage);
    });
  }

  initPrisms();
  document.addEventListener('astro:page-load', initPrisms);
  document.addEventListener('astro:before-swap', teardownPrisms);
</script>
