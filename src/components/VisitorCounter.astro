---
// VisitorCounter is now fully client-side — no server fetch at build time.
// It renders itself into #footer-visitor-counter-mount via the script below.
---

<script>
  const ABACUS_BASE = 'https://abacus.jasoncameron.dev';
  const ABACUS_NS   = 'twwh-archive';
  const ABACUS_KEY  = 'visits';

  function isDev(): boolean {
    const h = window.location.hostname;
    return h === 'localhost' || h === '127.0.0.1' || h.endsWith('.local') || window.location.port !== '';
  }

  function isBot(): boolean {
    const ua = navigator.userAgent.toLowerCase();
    return ['bot','spider','crawler','preview','lighthouse','headless','phantomjs',
      'selenium','puppeteer','playwright','curl','wget','monitor','uptime','scrap']
      .some(p => ua.includes(p)) || (navigator as any).webdriver === true;
  }

  function animateCount(el: HTMLElement, start: number, end: number, duration = 900) {
    if (start === end) { el.textContent = end.toLocaleString(); return; }
    const t0 = performance.now();
    function tick(now: number) {
      const p = Math.min((now - t0) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(start + (end - start) * eased).toLocaleString();
      if (p < 1) requestAnimationFrame(tick);
      else el.textContent = end.toLocaleString();
    }
    requestAnimationFrame(tick);
  }

  function buildWidget(count: number): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'visitor-counter';
    wrap.id = 'visitor-counter';
    wrap.title = 'Total site visits — live';
    wrap.innerHTML = `
      <span class="visitor-counter__pulse" aria-hidden="true">
        <span class="visitor-counter__ping"></span>
        <span class="visitor-counter__core"></span>
      </span>
      <span class="visitor-counter__label">Visits</span>
      <span class="visitor-counter__count" id="visitor-count-number" aria-live="polite">${count.toLocaleString()}</span>
    `;
    return wrap;
  }

  async function initVisitorCounter() {
    const mount = document.getElementById('footer-visitor-counter-mount');
    if (!mount || mount.dataset.loaded === 'true') return;
    mount.dataset.loaded = 'true';

    // Optimistic: show cached value immediately
    let cached = 0;
    try { cached = parseInt(localStorage.getItem('twwh_cached_visits') || '0', 10) || 0; } catch (_) {}

    const widget = buildWidget(cached);
    mount.appendChild(widget);
    const countEl = document.getElementById('visitor-count-number') as HTMLElement;

    const sessionKey = 'twwh_visit_tracked';
    const alreadyTracked = sessionStorage.getItem(sessionKey) === 'true';
    let current = cached;

    try {
      const endpoint = (!isDev() && !isBot() && !alreadyTracked)
        ? `${ABACUS_BASE}/hit/${ABACUS_NS}/${ABACUS_KEY}`
        : `${ABACUS_BASE}/get/${ABACUS_NS}/${ABACUS_KEY}`;

      if (!isDev() && !isBot() && !alreadyTracked) sessionStorage.setItem(sessionKey, 'true');

      const res = await fetch(endpoint, { signal: AbortSignal.timeout(4000) });
      if (res.ok) {
        const data = await res.json();
        if (typeof data?.value === 'number') current = data.value;
      }
    } catch (_) {}

    try { localStorage.setItem('twwh_cached_visits', String(current)); } catch (_) {}
    if (countEl) animateCount(countEl, cached, current);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initVisitorCounter);
  else initVisitorCounter();
  document.addEventListener('astro:page-load', initVisitorCounter);
</script>

<style is:global>
  .visitor-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    background: var(--bg-card);
    border: 2.5px solid var(--bark);
    border-radius: 3px;
    box-shadow: var(--shadow-brutal-sm);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--bark);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    user-select: none;
    transition: all 0.2s var(--ease-bounce);
  }
  .visitor-counter:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--bark);
    background: var(--yellow);
  }
  .visitor-counter__pulse {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 8px;
  }
  .visitor-counter__ping {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    background: var(--green);
    opacity: 0.75;
    animation: visitorPing 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .visitor-counter__core {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--green);
    box-shadow: 0 0 6px rgba(0, 204, 102, 0.6);
  }
  .visitor-counter__label { color: var(--text-muted); }
  .visitor-counter__count {
    font-weight: 500;
    color: var(--bark);
    min-width: 2ch;
  }
  @keyframes visitorPing {
    75%, 100% { transform: scale(2.5); opacity: 0; }
  }
</style>
