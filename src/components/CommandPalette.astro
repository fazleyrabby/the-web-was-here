---
import { ERA_META, eraForYear } from '../lib/era';

const MIN_YEAR = 1990;
const MAX_YEAR = 2026;

const years = Array.from({ length: MAX_YEAR - MIN_YEAR + 1 }, (_, i) => {
  const y = MIN_YEAR + i;
  const era = eraForYear(y);
  return { year: y, era, label: ERA_META[era].label };
});
---

<div class="cmdk" id="cmdk" data-open="false">
  <button type="button" class="cmdk__trigger" id="cmdk-trigger" aria-haspopup="dialog" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    <span>Jump to a year</span>
    <kbd>⌘K</kbd>
  </button>

  <div class="cmdk__overlay" id="cmdk-overlay" role="dialog" aria-modal="true" aria-label="Jump to a year">
    <div class="cmdk__panel" role="document">
      <div class="cmdk__input-row">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input
          type="text"
          class="cmdk__input"
          id="cmdk-input"
          placeholder="Search years or eras…"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="cmdk__esc">esc</kbd>
      </div>

      <ul class="cmdk__list" id="cmdk-list" role="listbox">
        {years.map((y) => (
          <li class="cmdk__item" role="option" data-year={y.year} data-search={`${y.year} ${y.label.toLowerCase()}`}>
            <a href={`/the-web/${y.year}`} class="cmdk__link">
              <span class="cmdk__year">{y.year}</span>
              <span class="cmdk__era">{y.label}</span>
              <svg class="cmdk__arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </li>
        ))}
        <li class="cmdk__empty" id="cmdk-empty" hidden>No matches</li>
      </ul>

      <div class="cmdk__footer">
        <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
        <span><kbd>↵</kbd> open</span>
        <span><kbd>esc</kbd> close</span>
      </div>
    </div>
  </div>
</div>

<script>
  function initCommandPalette() {
    const root = document.getElementById('cmdk');
    const trigger = document.getElementById('cmdk-trigger');
    const overlay = document.getElementById('cmdk-overlay');
    const input = document.getElementById('cmdk-input') as HTMLInputElement | null;
    const list = document.getElementById('cmdk-list');
    const empty = document.getElementById('cmdk-empty');
    if (!root || !overlay || !input || !list) return;
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    let previousFocus: HTMLElement | null = null;

    const items = Array.from(list.querySelectorAll<HTMLElement>('.cmdk__item'));
    let active = 0;

    function visibleItems() {
      return items.filter((i) => !i.hasAttribute('hidden'));
    }

    function setActive(index: number) {
      const vis = visibleItems();
      if (!vis.length) return;
      active = (index + vis.length) % vis.length;
      items.forEach((i) => i.classList.remove('is-active'));
      vis[active].classList.add('is-active');
      vis[active].scrollIntoView({ block: 'nearest' });
    }

    function filter() {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((item) => {
        const hay = item.getAttribute('data-search') || '';
        const match = !q || hay.includes(q);
        item.toggleAttribute('hidden', !match);
        if (match) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
      active = 0;
      setActive(0);
    }

    function open() {
      previousFocus = document.activeElement as HTMLElement;
      root.setAttribute('data-open', 'true');
      overlay.classList.add('is-open');
      trigger?.setAttribute('aria-expanded', 'true');
      input.value = '';
      filter();
      setTimeout(() => input.focus(), 30);
    }

    function close() {
      root.setAttribute('data-open', 'false');
      overlay.classList.remove('is-open');
      trigger?.setAttribute('aria-expanded', 'false');
      input.blur();
      previousFocus?.focus();
    }

    function isOpen() {
      return root.getAttribute('data-open') === 'true';
    }

    trigger?.addEventListener('click', () => (isOpen() ? close() : open()));
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
    input.addEventListener('input', filter);

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        isOpen() ? close() : open();
        return;
      }
      if (!isOpen()) return;
      if (e.key === 'Tab') {
        const controls = Array.from(overlay.querySelectorAll<HTMLElement>('input, a[href]')).filter((el) => el.getClientRects().length > 0);
        if (!controls.length) return;
        const first = controls[0];
        const last = controls[controls.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        return;
      }
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const vis = visibleItems();
        const link = vis[active]?.querySelector<HTMLAnchorElement>('.cmdk__link');
        if (link) window.location.href = link.href;
      }
    });
  }

  initCommandPalette();
  document.addEventListener('astro:page-load', initCommandPalette);
</script>

<style>
  .cmdk__trigger {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.8rem;
    background: rgba(14, 15, 19, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.82rem;
    cursor: pointer;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .cmdk__trigger:hover {
    color: #fff;
    border-color: rgba(198, 255, 61, 0.5);
    transform: translateY(-2px);
  }
  .cmdk__trigger svg { width: 16px; height: 16px; }
  .cmdk__trigger kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.12rem 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 5px;
    color: var(--text-muted);
  }

  .cmdk__overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    justify-content: center;
    align-items: flex-start;
    padding: 12vh 1rem 1rem;
    background: rgba(4, 4, 6, 0.66);
    backdrop-filter: blur(6px);
  }
  .cmdk__overlay.is-open { display: flex; }

  .cmdk__panel {
    width: 100%;
    max-width: 560px;
    background: #0e0f13;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.7);
    overflow: hidden;
    animation: cmdkIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes cmdkIn {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }

  .cmdk__input-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .cmdk__input-row svg { width: 18px; height: 18px; color: var(--text-muted); flex-shrink: 0; }
  .cmdk__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-family: var(--font-body);
    font-size: 1rem;
  }
  .cmdk__input::placeholder { color: var(--text-muted); }
  .cmdk__esc {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding: 0.12rem 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 5px;
    color: var(--text-muted);
  }

  .cmdk__list {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    max-height: 46vh;
    overflow-y: auto;
  }
  .cmdk__item { border-radius: 10px; }
  .cmdk__item.is-active { background: rgba(198, 255, 61, 0.1); }
  .cmdk__item.is-active .cmdk__arrow { opacity: 1; color: #c6ff3d; }
  .cmdk__link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.7rem;
    border-radius: 10px;
    text-decoration: none;
  }
  .cmdk__year {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    min-width: 3.2rem;
  }
  .cmdk__era { font-size: 0.82rem; color: var(--text-muted); flex: 1; }
  .cmdk__arrow { width: 16px; height: 16px; opacity: 0; transition: opacity 0.15s; }

  .cmdk__empty {
    padding: 1.2rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .cmdk__footer {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-muted);
  }
  .cmdk__footer kbd {
    font-family: var(--font-mono);
    padding: 0.05rem 0.28rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 4px;
  }

  @media (max-width: 520px) {
    .cmdk__trigger span { display: none; }
    .cmdk__overlay { padding-top: 8vh; }
  }
</style>
